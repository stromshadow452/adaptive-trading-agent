EXEC_FIELDS = ["ts","mode","symbol","tf","side","price","size","sl","tp","sl_type","status","order_id","plan_file"]

def read_existing_open_counts(exec_path: str) -> dict:
    counts={}
    if not os.path.exists(exec_path): return counts
    try:
        with open(exec_path,"r",encoding="utf-8",newline="") as f:
            reader=csv.DictReader(f)
            for row in reader:
                if (row.get("status") or "").upper()=="OPEN":
                    sym=(row.get("symbol") or "").upper()
                    counts[sym]=counts.get(sym,0)+1
    except Exception: pass
    return counts

def ensure_exec_header(exec_path: str):
    exists = os.path.exists(exec_path)
    if not exists or os.path.getsize(exec_path)==0:
        os.makedirs(os.path.dirname(exec_path), exist_ok=True)
        with open(exec_path,"w",encoding="utf-8",newline="") as f:
            writer=csv.DictWriter(f, fieldnames=EXEC_FIELDS); writer.writeheader()

def append_execution(exec_path: str, row: dict):
    ensure_exec_header(exec_path)
    with open(exec_path,"a",encoding="utf-8",newline="") as f:
        writer=csv.DictWriter(f, fieldnames=EXEC_FIELDS); writer.writerow(row)

@contextlib.contextmanager
def _csv_lock(path: str, timeout: float = 5.0, poll: float = 0.02, stale_sec: float = 60.0):
    lock = path + ".lock"
    start = time.time()
    fd = None
    while True:
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            try:
                os.write(fd, str(os.getpid()).encode("utf-8"))
            except Exception:
                pass
            break
        except FileExistsError:
            try:
                mtime = os.path.getmtime(lock)
                age = time.time() - mtime
                if age > stale_sec:
                    try:
                        os.remove(lock)
                        continue
                    except Exception:
                        pass
            except Exception:
                pass
            if (time.time() - start) > timeout:
                raise TimeoutError(f"Could not acquire CSV lock for {path} (timeout={timeout}s)")
            time.sleep(poll)
        except Exception:
            raise
    try:
        yield
    finally:
        try:
            if fd is not None:
                try: os.close(fd)
                except Exception: pass
            try: os.remove(lock)
            except Exception: pass
        except Exception:
            pass

def _stable_sort_plans(plans: List[dict]) -> List[dict]:
    def _key(p):
        c = p.get("candidate") or {}
        sym = (p.get("symbol") or c.get("symbol") or "ZZZ").upper()
        tf  = (p.get("tf") or p.get("timeframe") or c.get("tf") or c.get("timeframe") or "UNK").upper()
        return (sym, tf)
    try:
        return sorted(plans, key=_key)
    except Exception:
        return plans

def _exists_in_csv(exec_path: str, row: dict) -> bool:
    if not os.path.exists(exec_path) or os.path.getsize(exec_path) == 0:
        return False

    def _norm_key(d: dict):
        return (
            (d.get("symbol","") or "").upper(),
            (d.get("tf","") or "").upper(),
            (d.get("side","") or "").lower(),
        )
    def _to_float(x):
        try: return float(x)
        except Exception:
            try: return float(str(x or "0").strip())
            except Exception: return 0.0

    want_key = _norm_key(row)
    want_px = _to_float(row.get("price"))
    TOL = 1e-5

    try:
        with open(exec_path, "r", encoding="utf-8", newline="") as f:
            rdr = csv.DictReader(f)
            for r in rdr:
                if (r.get("status","").upper() != "OPEN"):
                    continue
                if _norm_key(r) != want_key:
                    continue
                existing_px = _to_float(r.get("price"))
                if abs(existing_px - want_px) <= TOL:
                    return True
    except Exception:
        return False
    return False

def append_execution_safe(exec_path: str, row: dict, *, dry_run: bool):
    if dry_run:
        return

    ts = row.get("timestamp") or row.get("ts") or now_utc_iso()
    row["timestamp"] = ts
    row["ts"] = row.get("ts") or ts

    try:
        row["price"] = f"{float(row['price']):.8f}"
    except Exception:
        pass

    ensure_exec_header(exec_path)
    try:
        with _csv_lock(exec_path, timeout=5.0, stale_sec=60.0):
            if _exists_in_csv(exec_path, row):
                return
            clean = {k: row.get(k, "") for k in EXEC_FIELDS}
            append_execution(exec_path, clean)
    except TimeoutError:
        if _exists_in_csv(exec_path, row):
            return
        clean = {k: row.get(k, "") for k in EXEC_FIELDS}
        append_execution(exec_path, clean)

def _normalize_agg_rows(rows: list[dict]) -> list[dict]:
    keep = ("symbol","tf","side","price","size","sl","tp","sl_type","status","plan_file")
    out: list[dict] = []
    for r in (rows or []):
        try:
            clean = {k: r.get(k) for k in keep}
            if "decision_reason" in r:
                clean["decision_reason"] = r["decision_reason"]
            out.append(clean)
        except Exception:
            continue
    out.sort(key=lambda x: (str(x.get("symbol","")), str(x.get("tf","")), str(x.get("side",""))))
    return out

def write_aggregate_safe(path: str, payload: dict, *, dry_run: bool):
    if not path or not payload:
        return
    obj = payload
    if dry_run:
        if isinstance(payload, dict) and isinstance(payload.get("orders"), list):
            obj = {"opened": int(payload.get("opened", 0)),
                   "orders": _normalize_agg_rows(payload["orders"])}
        elif isinstance(payload, list):
            obj = _normalize_agg_rows(payload)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, sort_keys=True, ensure_ascii=True, separators=(",", ":"))

