def _feature_list_hash(names) -> Optional[str]:
    if not names:
        return None
    h = hashlib.sha256()
    h.update(("\n".join([str(x) for x in names])).encode("utf-8"))
    return f"sha256:{h.hexdigest()}"

# ===== Robust model loader & save helper ======
def load_model_and_meta(model_path: str):
    if joblib is None:
        return None, {}
    if not model_path or not os.path.exists(model_path):
        return None, {}
    try:
        raw = joblib.load(model_path)
    except Exception as e:
        print(f"[meta] warn: failed joblib.load('{model_path}'): {e}")
        return None, {}

    meta = None
    model = raw

    if isinstance(raw, dict):
        meta = raw.get("meta") or raw.get("metadata") or {}
        model = raw.get("model") or raw.get("estimator") or raw.get("net") or raw.get("policy") or raw
    else:
        try:
            meta = getattr(raw, "meta", None) or getattr(raw, "metadata", None)
        except Exception:
            meta = None

    cand_files = [
        model_path + ".meta.json",
        model_path + ".joblib.meta.json",
        model_path + ".metadata.json",
        os.path.splitext(model_path)[0] + ".meta.json",
    ]
    for cand in cand_files:
        try:
            if os.path.exists(cand):
                with open(cand, "r", encoding="utf-8") as fh:
                    meta_from_file = json.load(fh)
                if not meta:
                    meta = meta_from_file
                break
        except Exception:
            continue

    meta = meta or {}
    tf = None
    try:
        tf = getattr(model, "timeframe", None)
    except Exception:
        tf = None
    if not tf:
        tf = meta.get("timeframe") or meta.get("tf") or meta.get("timeframe_iso")
    if tf and model is not None:
        try:
            if not getattr(model, "timeframe", None):
                setattr(model, "timeframe", tf)
        except Exception:
            pass

    return model, meta

def save_model_consistent(path: str, model_obj: Any, meta: dict):
    try:
        if meta and isinstance(meta, dict):
            if meta.get("timeframe"):
                try:
                    if not getattr(model_obj, "timeframe", None):
                        setattr(model_obj, "timeframe", meta.get("timeframe"))
                except Exception:
                    pass
            try:
                if not getattr(model_obj, "meta", None):
                    setattr(model_obj, "meta", meta)
            except Exception:
                pass
    except Exception:
        pass

    try:
        joblib.dump(model_obj, path)
    except Exception:
        try:
            joblib.dump({"model": model_obj, "meta": meta or {}}, path)
        except Exception as e:
            raise RuntimeError(f"Failed saving model to {path}: {e}")
    try:
        side = path + ".joblib.meta.json"
        with open(side, "w", encoding="utf-8") as fh:
            json.dump(meta or {}, fh)
    except Exception:
        pass

