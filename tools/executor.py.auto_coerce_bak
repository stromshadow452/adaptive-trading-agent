def _last_close_from_csv(csv_price_dir: str, symbol: str) -> float|None:
    if not csv_price_dir or not symbol: return None
    pats = [os.path.join(csv_price_dir, f"{symbol}_*.csv"),
            os.path.join(csv_price_dir, f"{symbol}*.csv")]
    files = []
    for p in pats: files.extend(glob.glob(p))
    if not files: return None
    files.sort(); last_file = files[-1]
    last_price = None
    try:
        with open(last_file,"r",encoding="utf-8-sig",newline="") as f:
            reader = csv.DictReader(f)
            for row in reader:
                for k in ("close","Close","CLOSE","c","ClosePrice","last"):
                    if k in row and row[k]:
                        try: last_price = float(row[k])
                        except Exception: pass
    except Exception: return None
    return last_price

def ensure_price_size_sl_tp(plan: dict, rcfg: dict, csv_price_dir: str) -> dict:
    price = _safe_float(globals().get("plan", {}).get("price"), 0.0)
    size  = _safe_float(globals().get("plan", {}).get("size"), 0.0)
    side  = (globals().get("plan", {}).get("side") or "").lower()
    if price>0.0 and size>0.0: return plan
    symbol = (globals().get("plan", {}).get("symbol") or globals().get("plan", {}).get("candidate", {}).get("symbol") or "").upper()
    if price<=0.0:
        px = _last_close_from_csv(csv_price_dir, symbol)
        if px and px>0: plan["price"]=px; price=px
    if size<=0.0 and price>0.0 and side in ("buy","sell"):
        plan["size"] = _recompute_size(plan, rcfg)
    if price>0.0 and side in ("buy","sell"):
        if globals().get("plan", {}).get("sl") is None or globals().get("plan", {}).get("tp") is None:
            sl,tp,_ = _compute_sl_tp(plan, rcfg)
            if globals().get("plan", {}).get("sl") is None: plan["sl"]=sl
            if globals().get("plan", {}).get("tp") is None: plan["tp"]=tp
    return plan

