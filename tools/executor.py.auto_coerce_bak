    ap.add_argument("--allow_symbols", nargs="*", default=[], help="If provided, restrict trading strictly to these symbols")

    ap.add_argument("--stale_max_minutes", type=int, default=15, help="Max allowed age (minutes) of last-csv-bar before treating stale")
    ap.add_argument("--future_tolerance_sec", type=int, default=60, help="Allowable future timestamp tolerance in seconds")

    args = ap.parse_args()
    _STRICT_META = bool(args.strict_meta)
    _EXPECT_TF = str(args.expect_timeframe or "").strip()

    exclude_set = {normalize_symbol(s).upper() for s in (args.exclude or []) if s}
    allow_set   = {normalize_symbol(s).upper() for s in (args.allow_symbols or []) if s}

    primary_model, primary_features = _load_model_and_features(args.model_primary_path, verbose=args.verbose)
    if args.verbose and primary_model is None:
        print("No primary model loaded — heuristic fallback will be used.")
    finrl_model, _ = _load_model_and_features(args.model_finrl_path, verbose=args.verbose) if args.model_finrl_path else (None, TRAIN_FEATURES_DEFAULT)
    if finrl_model is None and args.verbose:
        print("No finrl model preloaded — will use per-symbol auto-pick if a folder was provided, else heuristic fallback.")
    if (not args.disable_finrl) and finrl_model is not None and not os.path.isdir(str(args.model_finrl_path or "")):
        finrl_model = _wrap_generic(finrl_model)

    meta_info = {}
    try: meta_info = load_sidecar_meta(args.model_primary_path)
    except Exception: meta_info = {}
    try:
        expected = meta_info.get("feature_names") or primary_features
        exp_hash = feature_list_hash(expected)
    except Exception:
        expected = primary_features
        exp_hash = feature_list_hash(expected)

    print("=== Model Info ===")
    print(f"  name: {os.path.splitext(os.path.basename(args.model_primary_path))[0]}")
    print(f"  version: {meta_info.get('version','n/a')}")
    print(f"  timeframe: {meta_info.get('timeframe','n/a')}")
    print(f"  features: {len(expected)}  order_hash={exp_hash}")

    primary_features = list(expected)

    if _EXPECT_TF:
        tfm = PRIMARY_META.get("timeframe") or PRIMARY_META.get("tf") or PRIMARY_META.get("tf_filter")
        if not tfm or _EXPECT_TF.lower() not in str(tfm).lower():
            msg = f"model timeframe '{tfm}' does not satisfy --expect_timeframe '{_EXPECT_TF}'"
            if _STRICT_META: raise SystemExit(f"[meta] ERROR: {msg}")
            else: print(f"[meta] warn: {msg}")

    if args.verbose:
        dummy = {"decision":{"final_score":-1.0}, "candidate":{"atr":0.01}, "_plan_path":"EURUSD_M15_plan_x.json"}
        try:
            pc, fc = get_confidences(dummy, primary_model, None if args.disable_finrl else finrl_model, primary_features, args.csv_price_dir, verbose=args.verbose)
            print(f"[model sanity] primary_conf={pc:.3f}, finrl_conf={fc:.3f}")
        except Exception:
            print("[model sanity] error computing confidences:", traceback.format_exc())

    plans: List[dict]=[]
    def _load_one(path: str, tag: str):
        try:
            with open(path,"r",encoding="utf-8-sig") as f:
                data=json.load(f)
            if isinstance(data,list):
                for d in data:
                    if isinstance(d,dict):
                        d["_plan_path"]=path; plans.append(d)
            elif isinstance(data,dict):
                data["_plan_path"]=path; plans.append(data)
        except Exception:
            pass

    if args.approved:
        try:
            with open(args.approved,"r",encoding="utf-8-sig") as f:
                obj=json.load(f)
            if isinstance(obj,dict) and "approved" in obj: obj=obj["approved"]
            if isinstance(obj,list) and obj and all(isinstance(x,str) for x in obj):
                for p in obj:
                    if os.path.isdir(p):
                        for path in sorted(glob.glob(os.path.join(p,"*_plan_*.json"))):
                            _load_one(path,"dir")
                    elif os.path.isfile(p):
                        _load_one(p,"file")
            elif isinstance(obj,list) and obj and isinstance(obj[0],dict):
                for d in obj:
                    if isinstance(d,dict):
                        d["_plan_path"]=args.approved; plans.append(d)
            elif isinstance(obj,dict):
                obj["_plan_path"]=args.approved; plans.append(obj)
            else:
                _load_one(args.approved,"fallback")
        except Exception as e:
            print(f"Failed to load approved: {e}"); plans=[]
    else:
        folder = args.plans or ""
        for p in sorted(glob.glob(os.path.join(folder,"*_plan_*.json"))):
            _load_one(p,"plans")

    plans = _stable_sort_plans(plans)

    if not plans:
        print(f"Executed (opened): 0 (dry_run={args.dry_run})")
        return 0

    if not args.dry_run: ensure_exec_header(args.executions)
    open_counts = read_existing_open_counts(args.executions) if (not args.dry_run) else {}

    rows_out: List[dict] = []
    plans = _stable_sort_plans(plans)

    opened=0
    rcfg_for_patch={}
    simple_price_dir = args.csv_price_dir[0] if args.csv_price_dir else None
    agg_rows: list[dict] = []

    for plan in plans:
        if not isinstance(plan,dict): continue
        cand = globals().get("plan", {}).get("candidate", {}) if isinstance(globals().get("plan", {}).get("candidate"), dict) else {}
        sym = _extract_symbol_from_plan(plan, verbose=args.verbose)
        # FORCE-FALLBACK: if extractor returns UNKNOWN or empty, use explicit plan['symbol'] if present
        try:
            if isinstance(plan, dict) and (sym == "UNKNOWN" or not sym) and plan.get("symbol"):
                _try_sym = normalize_symbol(plan.get("symbol")).upper()
                if _try_sym and _try_sym != "UNKNOWN":
                    sym = _try_sym
                    if args.verbose: print(f"[sym] forced from plan.symbol -> {sym}")
        except Exception:
            pass
        if not globals().get("plan", {}).get("symbol"): plan["symbol"]=sym
        tf = (
            globals().get("plan", {}).get("tf")
            or globals().get("plan", {}).get("timeframe")
            or globals().get("cand", {}).get("tf")
            or globals().get("cand", {}).get("timeframe")
            or _tf_from_plan_path(globals().get("plan", {}).get("_plan_path"))
            or "UNK"
        )
        side = _infer_side(plan); plan["side"]=side

        if sym in exclude_set:
            if args.verbose: print(f"SKIP {sym}: excluded."); continue
        if args.allow_symbols and sym not in allow_set:
            if args.verbose: print(f"SKIP {sym}: not in allowlist {sorted(allow_set)}."); continue
        if not in_universe(sym, args.universe):
            if args.verbose: print(f"SKIP {sym}: not in universe {args.universe}."); continue

        cur_open = open_counts.get(sym,0)
        max_pos  = int(get_threshold_for(sym, "max_position", cli_default=args.max_position))
        if cur_open >= max(1, max_pos):
            if args.verbose: print(f"SKIP {sym}: at cap ({cur_open} >= {max_pos})."); continue

        price = _safe_float(globals().get("plan", {}).get("price"),0.0)
        used_path=None
        if price<=0.0 and args.csv_price_dir:
            px, pth = resolve_price_from_dirs(sym, args.csv_price_dir, verbose=args.verbose)
            if px is not None and px>0: plan["price"]=px; price=px; used_path=pth
        csv_hint = globals().get("cand", {}).get("csv_path")
        if price<=0.0 and csv_hint and os.path.isfile(csv_hint):
            px=_read_last_close_any(csv_hint)
            if px is not None and px>0: plan["price"]=px; price=px; used_path=csv_hint
        if price<=0.0 and simple_price_dir:
            plan = ensure_price_and_size(plan, rcfg_for_patch, simple_price_dir)
            price = _safe_float(globals().get("plan", {}).get("price"),0.0)
        if price<=0.0 and args.csv_price_dir:
            px = _super_last_price_guess(sym, args.csv_price_dir)
            if px is not None and px>0:
                plan["price"]=px; price=px
                if args.verbose: print(f"[price-last] {sym}: FOUND value={px}")

        last_ts = globals().get("plan", {}).get("_bar_ts_iso") or (_resolve_last_ts(sym, used_path) if used_path else "")
        if last_ts:
            if _stale_csv_guard(last_ts,
                                max_age_min=getattr(args, "stale_max_minutes", 15),
                                future_tol_sec=getattr(args, "future_tolerance_sec", 60)):
                if args.verbose: print(f"SKIP {sym}: stale bar ({last_ts})")
                continue
            plan["_bar_ts_iso"] = globals().get("plan", {}).get("_bar_ts_iso") or last_ts

        if args.require_csv_price and (price is None or price==0):
            if args.verbose: print(f"SKIP {sym}: require_csv_price True but no CSV price found.")
            continue

        price = float(price or 0.0)

        size_plan = float(globals().get("plan", {}).get("size") or globals().get("plan", {}).get("decision", {}).get("size") or 0.0)
        sl, tp = globals().get("plan", {}).get("sl"), globals().get("plan", {}).get("tp")
        sltype = globals().get("plan", {}).get("sl_type") or globals().get("plan", {}).get("decision", {}).get("sl_type") or "none"

        if side in {"buy","sell"} and size_plan<=0 and price>0.0:
            atr_hint = globals().get("plan", {}).get("atr")
            if atr_hint is None:
                cand_atr = globals().get("cand", {}).get("atr") or globals().get("cand", {}).get("atr14")
                atr_hint = cand_atr if isinstance(cand_atr,(int,float,str)) else None
            try: atr_val=float(atr_hint) if atr_hint is not None else 0.0
            except Exception: atr_val=0.0
            size_plan=_fallback_size_from_price_atr(price=price, atr=atr_val,
                                                    risk_per_trade=0.01, equity=10000.0,
                                                    stop_atr_mult=1.5, sl_pct=0.01,
                                                    min_size=0.001, max_size=0.05)

        if size_plan>0:
            size_plan = _lot_clamp(size_plan, min_lot=args.broker_min_lot, lot_step=args.broker_lot_step, min_size_cfg=args.decision_min_size)

        if side not in {"buy","sell"} or size_plan<=0:
            if args.verbose: print(f"SKIP {sym}: invalid side/size (side={side}, size={size_plan}).")
            continue

        finrl_model_eff = None if args.disable_finrl else finrl_model
        if (not args.disable_finrl) and args.model_finrl_path and os.path.isdir(args.model_finrl_path):
            picked = _try_finrl_for_symbol(sym, str(tf).upper(), args.model_finrl_path)
            if picked is None: picked = _try_finrl_for_symbol(sym, str(tf).lower(), args.model_finrl_path)
            if picked is not None:
                finrl_model_eff = picked
                if args.verbose: print(f"[finrl] {sym} {tf}: using per-symbol FinRL model from '{args.model_finrl_path}'")

        decision, size_factor, reason = decide_and_execute(
            plan, primary_model, finrl_model_eff, primary_features, args.csv_price_dir,
            args.primary_thresh, args.finrl_thresh, args.grey_zone, verbose=args.verbose
        )
        if decision.startswith("SKIPPED"):
            if args.verbose: print(f"SKIP {sym}: {reason}")
            continue

        final_size = _lot_clamp(size_plan*(size_factor or 1.0),
                                min_lot=args.broker_min_lot, lot_step=args.broker_lot_step, min_size_cfg=args.decision_min_size)

        order_id = f"{sym}-{int(time.time()*1000)}"
        row = {
            "ts": "", "mode": args.mode, "symbol": sym, "tf": tf, "side": side,
            "price": f"{price:.8f}", "size": f"{final_size:.8f}",
            "sl": "" if sl is None else f"{float(sl):.8f}",
            "tp": "" if tp is None else f"{float(tp):.8f}",
            "sl_type": sltype, "status": "OPEN", "order_id": order_id,
            "plan_file": globals().get("plan", {}).get("_plan_path") or (args.approved or args.plans),
        }

        if globals().get("plan", {}).get("_bar_ts_iso"):
            row["timestamp"] = globals().get("plan", {}).get("_bar_ts_iso")

        agg_rows.append(row.copy())

        try:
            if not zero_guard(row, None, rows_out):
                try:
                    if agg_rows and isinstance(agg_rows[-1], dict):
                        agg_rows[-1]["status"] = "SKIPPED_ZERO_PRICE"
                except Exception:
                    pass
                continue
        except Exception:
            try:
                print("zero-price guard exception; skipping order:", traceback.format_exc())
            except Exception:
                pass
            continue

        rows_out.append(row.copy())

        if _exists_in_csv(args.executions, row):
            if args.verbose: print(f"[idempotent-skip] {sym} {tf} {side} @ {row.get('price')}")
            continue

        if args.dry_run:
            decision_ts = row.get("timestamp") or row.get("ts") or (globals().get("plan", {}).get("_bar_ts_iso") or "")
            ts_src = ("decision_ctx.bar_ts_iso" if globals().get("plan", {}).get("_bar_ts_iso")
                      else "row.ts" if row.get("ts")
                      else "missing")
            if (os.environ.get("STRICT_NO_CSV_TS","0") == "1") and (ts_src == "missing"):
                raise SystemExit("[FAIL:Execution Reflex Engine] timestamp fell back to csv_resolver with STRICT_NO_CSV_TS=1")
            print(f"[DRY OPEN] {sym} {tf} {side} price={price:.6f} size={final_size:.6f}  -> {decision}: {reason}")
            exec_row = {
                "timestamp": (decision_ts or ""),
                "symbol":       sym,
                "side":         side,
                "size":         final_size,
                "price":        row.get("price"),
                "primary_conf": locals().get("primary_conf"),
                "finrl_conf":   locals().get("finrl_conf"),
                "source":       "execution_reflex",
            }
            _require_exec_timestamp(exec_row)
            opened += 1
            open_counts[sym] = open_counts.get(sym,0)+1
            continue

        try:
            if 'zero_guard' in globals() and callable(zero_guard):
                try:
                    ok = zero_guard(row, None, rows_out)
                except Exception as _z:
                    if args.verbose: print(f"zero-price-guard error -> {_z}")
                    ok = True
            else:
                ok = True
            if not ok:
                if args.verbose: print(f"SKIP {sym}: zero-price guard triggered for row -> {row}")
                continue
        except Exception as _e:
            if args.verbose: print(f"zero-price-guard outer error -> {_e}")

        append_execution_safe(args.executions, row, dry_run=args.dry_run)
        opened += 1
        open_counts[sym] = open_counts.get(sym,0)+1
        if used_path:
            print(f"[OPEN] {sym} {tf} {side} price={price:.6f} size={final_size:.6f} (csv={used_path})  -> {decision}: {reason}")
        else:
            print(f"[OPEN] {sym} {tf} {side} price={price:.6f} size={final_size:.6f}  -> {decision}: {reason}")

    try:

        del globals()['plan']

    except Exception:

        pass


    if args.dry_run and DRY_WRITE_ALLOWED and args.executions and rows_out:
        try:
            ensure_exec_header(args.executions)
            for r in rows_out:
                r["timestamp"] = (r.get("timestamp") or r.get("ts") or now_utc_iso())
                if not r["timestamp"]:
                    raise SystemExit("[FAIL:Execution Reflex Engine] missing timestamp (pre-write batch)")
                r["ts"] = r.get("ts") or r["timestamp"]
                try: r["price"] = f"{float(r['price']):.8f}"
                except Exception: pass
                clean = {k: r.get(k, "") for k in EXEC_FIELDS}
                append_execution_safe(args.executions, clean, dry_run=args.dry_run)
            if args.verbose:
                print(f"[artifact] wrote executions -> {args.executions} (dry_run)")
        except Exception as e:
            print(f"[warn] could not write executions file: {e}")
    if args.aggregate:
        write_aggregate_safe(args.aggregate, {"opened": opened, "orders": agg_rows}, dry_run=args.dry_run)
        print(f"[artifact] wrote aggregate -> {args.aggregate}")
    print(f"Executed (opened): {opened} (dry_run={args.dry_run})")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())

