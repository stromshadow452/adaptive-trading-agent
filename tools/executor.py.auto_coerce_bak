# ------------------------- Plan filename → symbol fallback -------------------------
def _symbol_from_plan_path(plan_path: Optional[str]) -> Optional[str]:
    """
    Extract an obvious symbol from plan filename, e.g. "EURUSD_M15_plan_x.json" -> "EURUSD"
    Returns None if not found.
    """
    if not plan_path:
        return None
    b = os.path.basename(plan_path).upper()
    # common pattern: 6-letter currency pair like EURUSD, GBPUSD, BTCUSD
    m = re.search(r'([A-Z]{3}[ _\-]?[A-Z]{3})', b)
    if m:
        sym = m.group(1).replace('_','').replace('-','')
        if len(sym) >= 6:
            return sym[:6]
    # fallback: contiguous 6-letter segment
    m2 = re.search(r'([A-Z]{6})', b)
    if m2:
        return m2.group(1)
    # last resort: return None
    return None

