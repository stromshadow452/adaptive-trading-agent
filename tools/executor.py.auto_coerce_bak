def _infer_side(plan: dict) -> str:
    cand = globals().get("plan", {}).get("candidate", {}) if isinstance(globals().get("plan", {}).get("candidate"), dict) else {}
    dec  = globals().get("plan", {}).get("decision", {})  if isinstance(globals().get("plan", {}).get("decision"), dict)  else {}
    candidates = [globals().get("plan", {}).get("side"), dec.get("side"), dec.get("action"), dec.get("signal"),
                  globals().get("cand", {}).get("side"), globals().get("cand", {}).get("action"), globals().get("cand", {}).get("signal")]
    for k in ("is_long","long","go_long"):
        v = dec.get(k, globals().get("cand", {}).get(k, globals().get("plan", {}).get(k)))
        if v is True or v==1: return "buy"
    for k in ("is_short","short","go_short"):
        v = dec.get(k, globals().get("cand", {}).get(k, globals().get("plan", {}).get(k)))
        if v is True or v==1: return "sell"
    for v in candidates:
        if not isinstance(v,(str,int,float)) or v is None: continue
        s=str(v).strip().lower()
        if s in {"buy","long","b","1","+1"}: return "buy"
        if s in {"sell","short","s","-1"}: return "sell"
    try: score=float(dec.get("final_score", globals().get("plan", {}).get("final_score", globals().get("cand", {}).get("score",0))))
    except Exception: score=None
    if isinstance(score,(int,float)) and score is not None:
        if score>0: return "buy"
        if score<0: return "sell"
    return ""

def _finrl_infer_conf(finrl_model: Any, fv: List[float], verbose: bool=False) -> Optional[float]:
    if finrl_model is None or fv is None:
        return None
    finrl_model = _deep_unwrap(finrl_model)
    if verbose:
        print(f"[finrl-debug] effective_model={type(finrl_model).__name__} "
              f"has_proba={hasattr(finrl_model,'predict_proba')} "
              f"has_conf={hasattr(finrl_model,'predict_confidence')} "
              f"has_predict={hasattr(finrl_model,'predict')}")
    try:
        if lgb is not None and isinstance(finrl_model, lgb.Booster):
            booster = finrl_model
            try:
                booster.set_param({"predict_disable_shape_check": True})
            except Exception:
                pass
            nexp = _lgb_expected_nfeat(booster) or 0
            if verbose:
                print(f"[finrl-debug] lgb.Booster expects {nexp} features; live={len(fv)}")
            names = (PRIMARY_META.get("feature_names") or PRIMARY_META.get("features") or TRAIN_FEATURES_DEFAULT)
            live_features_row: Dict[str, float] = {}
            for i, nm in enumerate(names):
                val = fv[i] if i < len(fv) else 0.0
                try:
                    live_features_row[str(nm)] = float(val)
                except Exception:
                    live_features_row[str(nm)] = 0.0
            x = align_features_for_lgb(live_features_row, booster)
            try:
                print(f"[finrl-align] using {x.shape[1]} features in trained order")
            except Exception:
                pass
            try:
                proba = float(booster.predict(x)[0])
                if verbose:
                    print(f"[finrl-debug] lgb.predict -> prob={proba}")
                return proba
            except Exception as e:
                if verbose:
                    print(f"[finrl-debug] lgb.predict error: {e}")
    except Exception:
        pass
    def _try_call(meth: str, payload):
        func = getattr(finrl_model, meth, None)
        if callable(func):
            try:
                return func(payload)
            except Exception:
                return None
        return None
    res = _try_call("predict_proba", [fv])
    if res is not None:
        prob = _to_prob(res[0] if isinstance(res,(list,tuple,np.ndarray)) else res)
        if verbose: print(f"[finrl-debug] predict_proba -> {prob}")
        if prob is not None: return prob
    res = _try_call("predict_confidence", [fv])
    if res is not None:
        val = res[0] if isinstance(res,(list,tuple,np.ndarray)) else res
        prob = _to_prob(val)
        if verbose: print(f"[finrl-debug] predict_confidence -> {prob}")
        if prob is not None: return prob
    res = _try_call("predict", [fv])
    if res is not None:
        val = res[0] if isinstance(res,(list,tuple,np.ndarray)) else res
        prob = _to_prob(val)
        if verbose: print(f"[finrl-debug] predict -> raw:{val} prob:{prob}")
        if prob is not None: return prob
    for m in ("predict_action","act","action"):
        res = _try_call(m, [fv])
        if res is None: res = _try_call(m, fv)
        if res is not None:
            val = res[0] if isinstance(res,(list,tuple,np.ndarray)) else res
            prob = _to_prob(val)
            if verbose: print(f"[finrl-debug] {m} -> raw:{val} prob:{prob}")
            if prob is not None: return prob
    for payload in ([fv], fv):
        res = _try_call("forward", payload)
        if res is not None:
            prob = _to_prob(res)
            if verbose: print(f"[finrl-debug] forward -> {prob}")
            if prob is not None: return prob
        try:
            call_res = finrl_model(payload)
            prob = _to_prob(call_res)
            if verbose: print(f"[finrl-debug] __call__ -> {prob}")
            if prob is not None: return prob
        except Exception:
            pass
    for m in ("decision_function","score"):
        res = _try_call(m, [fv])
        if res is not None:
            prob = _to_prob(res)
            if prob is not None: return prob
    for attr in ("policy_output","last_action","last_logits"):
        try:
            val = getattr(finrl_model, attr, None)
            prob = _to_prob(val)
            if prob is not None:
                return prob
        except Exception:
            pass
    if verbose:
        print(f"[finrl-debug] no usable FinRL method found on {type(finrl_model).__name__}")
    return None

