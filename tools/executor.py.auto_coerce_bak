# === Generic policy adapter + deep unwrap ====================================
_UNWRAP_ATTRS = ("policy","model","estimator","clf","base","inner","wrapped","net","sk_model")

def _deep_unwrap(obj, max_depth: int = 5):
    seen = set()
    cur = obj
    for _ in range(max_depth):
        if cur is None:
            return None
        if id(cur) in seen:
            break
        seen.add(id(cur))
        if isinstance(cur, dict):
            for k in _UNWRAP_ATTRS:
                if k in cur and cur[k] is not None:
                    cur = cur[k]
                    break
            else:
                return cur
            continue
        moved = False
        for k in _UNWRAP_ATTRS:
            try:
                nxt = getattr(cur, k, None)
            except Exception:
                nxt = None
            if nxt is not None:
                cur = nxt
                moved = True
                break
        if not moved:
            return cur
    return cur

class _GenericPolicyAdapter:
    def __init__(self, base):
        self.base = base

    def predict_proba(self, X):
        b = self.base
        if hasattr(b, "predict_proba"):
            return b.predict_proba(X)
        if hasattr(b, "decision_function"):
            z = b.decision_function(X)
            z = np.asarray(z).reshape(-1, 1)
            p = 1.0 / (1.0 + np.exp(-z))
            return np.hstack([1.0 - p, p])
        if hasattr(b, "predict"):
            y = np.asarray(b.predict(X)).reshape(-1)
            def _to_p(v):
                s = str(v).strip().lower()
                return 0.70 if s in {"1","buy","long","true","+1"} else 0.30
            p = np.array([_to_p(v) for v in y], dtype=float)
            return np.stack([1.0 - p, p], axis=1)
        if hasattr(b, "score"):
            try:
                z = float(b.score(X))
                p = 1.0 / (1.0 + np.exp(-z))
                return np.array([[1.0 - p, p] for _ in range(len(X))], dtype=float)
            except Exception:
                pass
        raise AttributeError("Adapter: no usable prediction on wrapped estimator")

def _wrap_generic(obj):
    return _GenericPolicyAdapter(_deep_unwrap(obj))

# === FinRL per-symbol auto-picker (robust globbing) ===
def _try_finrl_for_symbol(sym: str, tf: str, root: Optional[str]):
    if not root or joblib is None: return None
    try:
        if not os.path.isdir(root): return None
        def _cands(sym_in: str, tf_in: str) -> List[str]:
            pats = [
                f"{sym_in}_{tf_in}_policy.joblib",
                f"{sym_in}_{tf_in}.joblib",
                f"{sym_in}_{tf_in}_ppo.joblib",
                f"{sym_in}_{tf_in}_policy.pkl",
                f"{sym_in}_{tf_in}_*policy*.joblib",
                f"{sym_in}_{tf_in}_*policy*.pkl",
            ]
            out=[]
            for pat in pats: out.extend(glob.glob(os.path.join(root, pat)))
            return out
        cands = _cands(sym, tf) + _cands(sym.lower(), tf.lower())
        cands = sorted(set(cands), key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
        for p in cands:
            try:
                raw = joblib.load(p)
                return _wrap_generic(raw)
            except Exception:
                continue
    except Exception:
        return None
    return None

# ---- conservative fallback sizing ----
def _fallback_size_from_price_atr(price: float, atr: Optional[float],
                                  risk_per_trade: float=0.01, equity: float=10000.0,
                                  stop_atr_mult: float=1.5, sl_pct: float=0.01,
                                  min_size: float=0.001, max_size: float=0.05) -> float:
    if price<=0.0: return 0.0
    try: a = float(atr) if atr is not None else 0.0
    except Exception: a = 0.0
    stop_dist = (a*stop_atr_mult) if a>0.0 else (price*sl_pct)
    if stop_dist<=0.0: return 0.0
    notional = equity*risk_per_trade
    size = notional/(stop_dist*price)
    return max(min_size, min(max_size, float(size)))

