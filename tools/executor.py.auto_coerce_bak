def validate_feature_compat(meta: dict, live_feat_names, strict: bool):
    want_names = meta.get("feature_names") or meta.get("features")
    want_hash  = meta.get("feature_order_hash") or _feature_list_hash(want_names or [])
    def _fail(msg):
        if strict: raise SystemExit(f"[meta] ERROR: {msg}")
        else: print(f"[meta] warn: {msg}")
    if not live_feat_names or not want_names:
        if want_names and live_feat_names and len(want_names) != len(live_feat_names):
            _fail(f"feature length mismatch: model={len(want_names)} vs live={len(live_feat_names)}")
        return
    if len(want_names) != len(live_feat_names):
        _fail(f"feature length mismatch: model={len(want_names)} vs live={len(live_feat_names)}"); return
    if list(want_names) != list(live_feat_names):
        _fail("feature names/order mismatch between model and live vector.")
        try:
            for i, (a,b) in enumerate(zip(want_names, live_feat_names)):
                if a != b:
                    print(f"  mismatch @ {i}: model='{a}' live='{b}'")
                    if i>10: break
        except Exception: pass
    live_hash = _feature_list_hash(live_feat_names)
    if want_hash and live_hash and want_hash != live_hash:
        _fail(f"feature order hash mismatch: model={want_hash} live={live_hash}")

# ================== math helpers & sizing ==================
def _safe_float(x, d=0.0):
    try:
        v = float(x)
        if math.isnan(v) or math.isinf(v): return d
        return v
    except Exception:
        return d

def _sigmoid(z: float) -> float:
    try:
        return 1.0/(1.0+math.exp(-float(z)))
    except Exception:
        return 0.5

def _to_prob(v: Any) -> Optional[float]:
    try:
        if v is None: return None
        if isinstance(v, (list, tuple, np.ndarray)):
            if len(v)==0: return None
            flat = list(v)
            if len(flat)==1 and isinstance(flat[0], (list, tuple, np.ndarray)):
                flat = list(flat[0])
            nums = [float(x) for x in flat if isinstance(x,(int,float,np.floating))]
            if not nums: return None
            if all(0.0 <= x <= 1.0 for x in nums):
                return max(nums)
            return _sigmoid(nums[0])
        raw = float(v)
        if raw in (0.0,1.0): return 0.70 if raw==1.0 else 0.30
        if -1.0 <= raw <= 1.0: return _sigmoid(raw)
        return _sigmoid(raw)
    except Exception:
        return None

def _fit_to_len(fv: List[float], n: int) -> List[float]:
    if n is None or n <= 0:
        return list(fv)
    if len(fv) == n:
        return list(fv)
    if len(fv) > n:
        return list(fv[:n])
    return list(fv) + [0.0] * (n - len(fv))

def _lgb_expected_nfeat(booster) -> Optional[int]:
    n = None
    try:
        n = int(booster.num_feature())
    except Exception:
        n = None
    if (n is None or n <= 0):
        try:
            names = booster.feature_name()
            if isinstance(names, (list, tuple)) and len(names) > 0:
                n = len(names)
        except Exception:
            pass
    return n

def _recompute_size(plan: dict, rcfg: dict) -> float:
    risk_per_trade = _safe_float(rcfg.get("risk_per_trade"), 0.01)
    equity = _safe_float(globals().get("plan", {}).get("equity"), _safe_float(rcfg.get("default_equity"), 10000.0))
    price = _safe_float(globals().get("plan", {}).get("price"), 0.0)
    atr = _safe_float(globals().get("plan", {}).get("atr") or globals().get("plan", {}).get("atr14"), 0.0)
    stop_mult = _safe_float(rcfg.get("stop_atr_mult"), 1.5)
    sl_pct = _safe_float(rcfg.get("sl_pct"), 0.01)
    eps = 1e-9
    if price <= eps: return 0.0
    stop_dist = max(atr*stop_mult, eps) if atr>eps else max(price*sl_pct, eps)
    notional = equity*risk_per_trade
    size = notional/(stop_dist*price)
    size = max(_safe_float(rcfg.get("min_size"),0.001), min(_safe_float(rcfg.get("max_size"),0.05), size))
    return max(0.0, size)

def _compute_sl_tp(plan: dict, rcfg: dict) -> tuple[float|None, float|None, str]:
    price = _safe_float(globals().get("plan", {}).get("price"), 0.0)
    atr = _safe_float(globals().get("plan", {}).get("atr") or globals().get("plan", {}).get("atr14"), 0.0)
    side = (globals().get("plan", {}).get("side") or "").lower()
    stop_mult = _safe_float(rcfg.get("stop_atr_mult"), 1.5)
    rr = _safe_float(rcfg.get("takeprofit_rr"), 1.5)
    sl_pct = _safe_float(rcfg.get("sl_pct"), 0.01)
    tp_pct = _safe_float(rcfg.get("tp_pct"), 0.02)
    eps = 1e-9
    if price <= eps: return None, None, "none"
    if atr > eps:
        stop_dist = atr*stop_mult
        tp_dist = stop_dist*rr
        if side=="buy":  return price-stop_dist, price+tp_dist, "atr"
        if side=="sell": return price+stop_dist, price-tp_dist, "atr"
    if side=="buy":  return price*(1-sl_pct), price*(1+tp_pct), "pct"
    if side=="sell": return price*(1+sl_pct), price*(1-tp_pct), "pct"
    return None, None, "none"

