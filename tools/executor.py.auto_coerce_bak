def heuristic_confidence_from_score(plan: dict) -> float:
    score=None
    if "decision" in plan and isinstance(plan["decision"], dict):
        score = plan["decision"].get("final_score")
    if score is None:
        score = globals().get("plan", {}).get("final_score") or (globals().get("plan", {}).get("candidate") or {}).get("score")
    try: s=float(score or 0.0)
    except Exception: s=0.0
    mag=abs(s); k=1.0
    conf = 1.0 - math.exp(-mag/k)
    return max(0.0, min(1.0, conf))

