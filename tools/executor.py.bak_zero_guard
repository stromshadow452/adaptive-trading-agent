def _extract(d: dict, *paths, default=None):
    for p in paths:
        cur = d
        try:
            for k in p.split("."):
                if isinstance(cur, dict) and k in cur: cur = cur[k]
                else: cur=None; break
            if cur not in (None,""): return cur
        except Exception: pass
    return default

