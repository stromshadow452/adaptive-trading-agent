def ensure_price_and_size(plan: dict, rcfg: dict, csv_price_dir: str|None) -> dict:
    price = _safe_float(plan.get("price"),0.0)
    size = _safe_float(plan.get("size"),0.0)
    if price>0 and size>0: return plan
    sym = (plan.get("symbol") or plan.get("candidate", {}).get("symbol") or "").upper()
    if not csv_price_dir or not sym: return plan
    import glob as _glob, os as _os
    pat1 = _os.path.join(csv_price_dir,"**",f"{sym}*.csv")
    pat2 = _os.path.join(csv_price_dir,"**",f"*{sym}*.csv")
    files = sorted(set(_glob.glob(pat1, recursive=True)+_glob.glob(pat2, recursive=True)))
    if not files: return plan
    last_price = None
    try:
        with open(files[-1],"r",encoding="utf-8-sig",newline="") as f:
            reader=csv.DictReader(f); last=None
            for row in reader: last=row
            if last:
                for k in ("close","Close","CLOSE","c","ClosePrice","last"):
                    if k in last and last[k]:
                        try: last_price=float(last[k])
                        except Exception: pass
    except Exception: last_price=None
    if last_price and last_price>0:
        plan["price"]=last_price
        if size<=0.0: plan["size"]=_recompute_size_from_price(plan, rcfg)
    return plan

# --- lot clamp helpers ---
def _round_to_step(x: float, step: float) -> float:
    if step<=0: return x
    return math.floor(x/step)*step

def _lot_clamp(size: float, *, min_lot: float, lot_step: float, min_size_cfg: float) -> float:
    try:
        if not isinstance(size,(int,float)) or not math.isfinite(size) or size<=0: return 0.0
    except Exception:
        return 0.0
    stepped = _round_to_step(float(size), float(lot_step))
    stepped = max(stepped, float(min_lot))
    stepped = max(stepped, float(min_size_cfg))
    return round(stepped, 3)

# ------------------------- CSV pricing & discovery -------------------------
def last_close_from_csv_file(path: str) -> Optional[float]:
    try:
        df = pd.read_csv(path, sep=None, engine="python")
        cols = [c.strip().lower() for c in df.columns]
        if "close" not in cols: return None
        cidx = cols.index("close")
        return float(pd.to_numeric(df.iloc[-1, cidx], errors="coerce"))
    except Exception:
        try:
            with open(path,"r",encoding="utf-8") as f:
                reader=csv.reader(f); header=next(reader)
                lower=[h.strip().lower() for h in header]
                if "close" not in lower: return None
                idx=lower.index("close"); last=None
                for row in reader:
                    if row and any(c.strip() for c in row): last=row
                if not last: return None
                return float(last[idx])
        except Exception:
            return None

def symbol_variants(sym: str) -> List[str]:
    s=(sym or "").upper()
    base, quote = (s[:3], s[3:6]) if len(s)>=6 else (s,"")
    variants=set()
    if base and quote: variants.add(f"{base}{quote}")
    for q in QUOTE_PREFS:
        variants.add(f"{base}-{q}"); variants.add(f"{base}_{q}")
    variants |= {v.lower() for v in list(variants)}
    return list(variants)

def find_csv_for_symbol(sym: str, csv_dirs: List[str]) -> Optional[str]:
    candidates: List[str]=[]
    stems = symbol_variants(sym)
    for root in (csv_dirs or []):
        for stem in stems:
            patterns=[os.path.join(root,"**",f"{stem}*.csv"),
                      os.path.join(root,"**",f"*{stem}*.csv")]
            matches=[]
            for pat in patterns: matches.extend(glob.glob(pat, recursive=True))
            if matches: candidates.extend(matches)
    if not candidates: return None
    candidates.sort(key=os.path.getmtime, reverse=True)
    return candidates[0]

def _read_last_close_any(path: str) -> Optional[float]:
    try:
        df = pd.read_csv(path, sep=None, engine="python")
        cols = [c.strip().lower() for c in df.columns]
        if "close" in cols and len(df)>0:
            cidx = cols.index("close")
            return float(pd.to_numeric(df.iloc[-1, cidx], errors="coerce"))
    except Exception: pass
    try:
        with open(path,"r",encoding="utf-8-sig",newline="") as f:
            reader=csv.DictReader(f); last=None
            for row in reader: last=row
            if last:
                for k in ("close","Close","CLOSE","c","ClosePrice","last"):
                    if k in last and last[k]:
                        try: return float(last[k])
                        except Exception: continue
    except Exception: pass
    return None

