# === Generic policy adapter + deep unwrap ====================================
_UNWRAP_ATTRS = ("policy","model","estimator","clf","base","inner","wrapped","net","sk_model")

def _deep_unwrap(obj, max_depth: int = 5):
    """Recursively peel common wrapper attributes until we hit a bare estimator."""
    seen = set()
    cur = obj
    for _ in range(max_depth):
        if cur is None:
            return None
        if id(cur) in seen:
            break
        seen.add(id(cur))
        if isinstance(cur, dict):
            for k in _UNWRAP_ATTRS:
                if k in cur and cur[k] is not None:
                    cur = cur[k]
                    break
            else:
                return cur
            continue
        moved = False
        for k in _UNWRAP_ATTRS:
            try:
                nxt = getattr(cur, k, None)
            except Exception:
                nxt = None
            if nxt is not None:
                cur = nxt
                moved = True
                break
        if not moved:
            return cur
    return cur

class _GenericPolicyAdapter:
    """
    Wrap any sklearn-like/statsmodels-like estimator and expose predict_proba().
    """
    def __init__(self, base):
        self.base = base

    def predict_proba(self, X):
        b = self.base
        # 1) predict_proba native
        if hasattr(b, "predict_proba"):
            return b.predict_proba(X)
        # 2) decision_function -> sigmoid to prob
        if hasattr(b, "decision_function"):
            z = b.decision_function(X)
            z = np.asarray(z).reshape(-1, 1)
            p = 1.0 / (1.0 + np.exp(-z))
            return np.hstack([1.0 - p, p])
        # 3) predict -> soft map 0/1 or labels
        if hasattr(b, "predict"):
            y = np.asarray(b.predict(X)).reshape(-1)
            def _to_p(v):
                s = str(v).strip().lower()
                return 0.70 if s in {"1","buy","long","true","+1"} else 0.30
            p = np.array([_to_p(v) for v in y], dtype=float)
            return np.stack([1.0 - p, p], axis=1)
        # 4) score scalar -> broadcast
        if hasattr(b, "score"):
            try:
                z = float(b.score(X))
                p = 1.0 / (1.0 + np.exp(-z))
                return np.array([[1.0 - p, p] for _ in range(len(X))], dtype=float)
            except Exception:
                pass
        raise AttributeError("Adapter: no usable prediction on wrapped estimator")

def _wrap_generic(obj):
    return _GenericPolicyAdapter(_deep_unwrap(obj))
