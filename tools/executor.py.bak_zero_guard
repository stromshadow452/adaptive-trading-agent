_resolve_last_ts_cache = {}

def _resolve_last_ts(sym, used_path):
    """
    Deterministic, cached: return ISO-UTC timestamp (last bar) for symbol.
    Cache key = file path; no global I/O beyond first lookup per path.
    """
    try:
        key = str(used_path)
        if key in _resolve_last_ts_cache:
            return _resolve_last_ts_cache[key]
        # Fast, robust read with pandas; handle BOM
        import pandas as _pd
        try:
            df = _pd.read_csv(used_path, encoding="utf-8")
        except UnicodeDecodeError:
            df = _pd.read_csv(used_path, encoding="utf-8-sig")
        if df.empty:
            ts = ""
        else:
            # accept 'timestamp' or 'time'
            cols = {c.lower(): c for c in df.columns}
            ts_col = cols.get("timestamp") or cols.get("time")
            ts = "" if not ts_col else str(df[ts_col].iloc[-1])
            if ts:
                if "T" not in ts or not ts.endswith("Z"):
                    ts = ts.replace(" ", "T")
                    if not ts.endswith("Z"):
                        ts += "Z"
        _resolve_last_ts_cache[key] = ts
        return ts
    except Exception:
        return ""
# === [END DECISION TS RESOLVER] ===

_TEMP_PREFIXES = ("EXECUTOR_TEMP_PLAN","EXECUTOR_TEMP","EXECUTOR")

def _symbol_from_plan_path(plan_path: Optional[str]) -> Optional[str]:
    if not plan_path: return None
    base = os.path.basename(plan_path).upper()
    if any(base.startswith(p) for p in _TEMP_PREFIXES): return None
    m = _re_path.match(r"^([A-Z]{3,10})_([A-Z0-9]+)_PLAN_", base)
    if m: return normalize_symbol(m.group(1))
    m2 = _re_path.match(r"^([A-Z]{6})_", base)
    if m2: return normalize_symbol(m2.group(1))
    return None

