# === FinRL per-symbol auto-picker (robust globbing) ===
def _try_finrl_for_symbol(sym: str, tf: str, root: Optional[str]):
    if not root or joblib is None: return None
    try:
        if not os.path.isdir(root): return None
        def _cands(sym_in: str, tf_in: str) -> List[str]:
            pats = [
                f"{sym_in}_{tf_in}_policy.joblib",
                f"{sym_in}_{tf_in}.joblib",
                f"{sym_in}_{tf_in}_ppo.joblib",
                f"{sym_in}_{tf_in}_policy.pkl",
                f"{sym_in}_{tf_in}_*policy*.joblib",
                f"{sym_in}_{tf_in}_*policy*.pkl",
            ]
            out=[]
            for pat in pats: out.extend(glob.glob(os.path.join(root, pat)))
            return out
        cands = _cands(sym, tf) + _cands(sym.lower(), tf.lower())
        cands = sorted(set(cands), key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
        for p in cands:
            try:
                raw = joblib.load(p)
                return _wrap_generic(raw)
            except Exception:
                continue
    except Exception:
        return None
    return None

# ---- conservative fallback sizing ----
def _fallback_size_from_price_atr(price: float, atr: Optional[float],
                                  risk_per_trade: float=0.01, equity: float=10000.0,
                                  stop_atr_mult: float=1.5, sl_pct: float=0.01,
                                  min_size: float=0.001, max_size: float=0.05) -> float:
    if price<=0.0: return 0.0
    try: a = float(atr) if atr is not None else 0.0
    except Exception: a = 0.0
    stop_dist = (a*stop_atr_mult) if a>0.0 else (price*sl_pct)

    if stop_dist<=0.0: return 0.0
    notional = equity*risk_per_trade
    size = notional/(stop_dist*price)
    return max(min_size, min(max_size, float(size)))

