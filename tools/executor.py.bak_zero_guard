def heuristic_confidence_from_score(plan: dict) -> float:
    score=None
    if "decision" in plan and isinstance(plan["decision"], dict):
        score = plan["decision"].get("final_score")
    if score is None:
        score = plan.get("final_score") or (plan.get("candidate") or {}).get("score")
    try: s=float(score or 0.0)
    except Exception: s=0.0
    mag=abs(s); k=1.0
    conf = 1.0 - math.exp(-mag/k)
    return max(0.0, min(1.0, conf))

def _extract_symbol_from_plan(plan: dict, verbose: bool=False) -> str:
    cand = plan.get("candidate", {}) if isinstance(plan.get("candidate"), dict) else {}
    for key in ("symbol","pair","asset"):
        raw = plan.get(key) or cand.get(key)
        if raw and isinstance(raw,str):
            sym = normalize_symbol(raw).upper()
            if verbose: print(f"[sym] from field '{key}' -> {sym}")
            return sym
    hints=[]
    for k in ("base","ticker","instrument"):
        if isinstance(cand.get(k),str): hints.append(cand.get(k))
    if hints:
        sym=normalize_symbol("".join(hints)).upper()
        if len(sym)>=6:
            if verbose: print(f"[sym] from nested hints -> {sym}")
            return sym
    guess = _symbol_from_plan_path(plan.get("_plan_path") or plan.get("plan_file"))
    if guess:
        sym=normalize_symbol(guess).upper()
        if verbose: print(f"[sym] from filename -> {sym}")
        return sym
    if verbose: print("[sym] default -> UNKNOWN]")
    return "UNKNOWN"

