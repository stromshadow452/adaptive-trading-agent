def _meta_path_for_model(model_path: str) -> str:
    base, _ = os.path.splitext(model_path)
    return f"{base}_metadata.json"

def _feature_list_hash(names) -> Optional[str]:
    if not names:
        return None
    h = hashlib.sha256()
    h.update(("\n".join([str(x) for x in names])).encode("utf-8"))
    return f"sha256:{h.hexdigest()}"

def load_model_and_meta(model_path: str):
    if joblib is None:
        return None, {}
    obj = joblib.load(model_path)
    model = obj.get("model") if isinstance(obj, dict) and "model" in obj else obj
    embedded_meta = obj.get("meta") if isinstance(obj, dict) and "meta" in obj else None
    sidecar_path = _meta_path_for_model(model_path)
    sidecar_meta = None
    if os.path.exists(sidecar_path):
        try:
            with open(sidecar_path, "r", encoding="utf-8") as f:
                sidecar_meta = json.load(f)
        except Exception as e:
            print(f"[meta] warn: failed reading sidecar '{sidecar_path}': {e}")
    meta = sidecar_meta or embedded_meta or {}
    return model, meta

