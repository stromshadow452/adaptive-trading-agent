def _normalize_ohlcv(df: pd.DataFrame) -> pd.DataFrame:
    lut = {re.sub(r"[<>]","",str(c)).strip().lower(): c for c in df.columns}
    def pick(*names):
        for n in names:
            if n in lut: return lut[n]
        return None
    c_open  = pick("open","o","bidopen","askopen")
    c_high  = pick("high","h","bidhigh","askhigh")
    c_low   = pick("low","l","bidlow","asklow")
    c_close = pick("close","c","bidclose","askclose","last","price","closeprice")
    c_vol   = pick("volume","vol","tickvol","tick_volume","tickvolume","v","tick vol","tickvol.")
    if c_open is None or c_high is None or c_low is None or c_close is None:
        raise ValueError("CSV missing OHLC columns")
    out = pd.DataFrame(index=df.index.copy())
    out["open"]  = pd.to_numeric(df[c_open], errors="coerce")
    out["high"]  = pd.to_numeric(df[c_high], errors="coerce")
    out["low"]   = pd.to_numeric(df[c_low], errors="coerce")
    out["close"] = pd.to_numeric(df[c_close], errors="coerce")
    out["volume"]= pd.to_numeric(df[c_vol], errors="coerce") if c_vol else 1.0
    date_col=time_col=ts_col=None
    for c in df.columns:
        cl=str(c).lower()
        if ("date" in cl) and date_col is None: date_col=c
        if (("time" in cl) or ("timestamp" in cl)) and time_col is None: time_col=c
        if cl=="timestamp": ts_col=c
    try:
        if date_col is not None and time_col is not None:
            dt = pd.to_datetime(df[date_col].astype(str)+" "+df[time_col].astype(str), errors="coerce", utc=True)
            out.index = dt
        elif ts_col is not None:
            out.index = pd.to_datetime(df[ts_col], errors="coerce", utc=True)
    except Exception: pass
    out = out.dropna(subset=["open","high","low","close"])
    return out

def _compute_atr(df: pd.DataFrame, window: int=14) -> pd.Series:
    h,l,c = df["high"], df["low"], df["close"]
    prev_c = c.shift(1)
    tr = pd.concat([(h-l).abs(), (h-prev_c).abs(), (l-prev_c).abs()], axis=1).max(axis=1)
    atr = tr.rolling(window=window, min_periods=window).mean()
    return atr.bfill().fillna(0.0)

def _compute_features_from_df(df: pd.DataFrame) -> pd.DataFrame:
    feat = pd.DataFrame(index=df.index)
    close=df["close"]
    feat["close"]=close
    feat["ret"]=close.pct_change(fill_method=None).fillna(0.0)
    feat["sma5"]=close.rolling(5,min_periods=5).mean()
    feat["sma20"]=close.rolling(20,min_periods=20).mean()
    feat["sma_ratio"]=(feat["sma5"]/(feat["sma20"].replace(0,np.nan))).ffill().fillna(1.0)
    feat["sma50"]=close.rolling(50,min_periods=50).mean()
    feat["sma100"]=close.rolling(100,min_periods=100).mean()
    feat["sma_ratio_long"]=(feat["sma50"]/(feat["sma100"].replace(0,np.nan))).ffill().fillna(1.0)
    feat["atr14"]=_compute_atr(df,14)
    feat["hl_range"]=(df["high"]-df["low"]).abs()
    feat["body"]=(close-df["open"]).abs()
    feat["ret_5"]=close.pct_change(5,fill_method=None).fillna(0.0)
    feat["ret_20"]=close.pct_change(20,fill_method=None).fillna(0.0)
    up=close.diff().clip(lower=0); down=(-close.diff().clip(upper=0)).abs()
    avg_gain=up.rolling(14,min_periods=14).mean()
    avg_loss=down.rolling(14,min_periods=14).mean().replace(0,np.nan)
    rs=(avg_gain/avg_loss).replace([np.inf,-np.inf],np.nan)
    feat["rsi14"]=(100-100/(1+rs)).fillna(50)
    mid=close.rolling(20,min_periods=20).mean()
    std=close.rolling(20,min_periods=20).std()
    feat["boll_z"]=((close-mid)/std.replace(0,np.nan)).fillna(0)
    feat["atr_pct"]=(feat["atr14"]/close).clip(lower=1e-8)
    v=df["volume"].replace([np.inf,-np.inf],np.nan).ffill().fillna(1.0)
    feat["vol_norm"]=(v - v.rolling(20,min_periods=1).mean())/(v.rolling(20,min_periods=1).std().replace(0,np.nan))
    feat["vol_norm"]=feat["vol_norm"].fillna(0.0)
    try:
        idx=pd.DatetimeIndex(feat.index)
        feat["hod"]=idx.hour.astype(float); feat["dow"]=idx.dayofweek.astype(float)
    except Exception:
        feat["hod"]=0.0; feat["dow"]=0.0
    feat=feat.ffill().bfill()
    return feat

def _read_tail_csv(path: str, nrows: int=400) -> pd.DataFrame:
    df = pd.read_csv(path, sep=None, engine="python")
    if len(df)>nrows: df=df.tail(nrows)
    return df.reset_index(drop=True)

def build_feature_vector_from_csv(sym: str, csv_dirs: List[str], expected_features: List[str], verbose: bool=False) -> Optional[Tuple[List[float], str]]:
    """
    Returns (feature_vector, last_bar_iso_timestamp) or None on failure.
    last_bar_iso is normalized to UTC and ends with 'Z' when possible.
    """
    csv_path = find_csv_for_symbol(sym, csv_dirs)
    if not csv_path:
        if verbose: print(f"primary: CSV not found for {sym}")
        return None
    try:
        raw = _read_tail_csv(csv_path, nrows=400)
        norm = _normalize_ohlcv(raw)
        feats = _compute_features_from_df(norm)
        live_feat_names = list(feats.columns)
        assert_feature_names(expected_features, live_feat_names)

        # last bar timestamp (zero-IO from the DataFrame you already have)
        try:
            last_dt = feats.index[-1]
            # ensure tz-aware UTC
            if getattr(last_dt, "tzinfo", None) is None:
                try:
                    last_dt = last_dt.tz_localize("UTC")
                except Exception:
                    last_dt = pd.to_datetime(last_dt).tz_localize("UTC")
            last_ts_iso = last_dt.tz_convert("UTC").isoformat().replace("+00:00","Z")
        except Exception:
            last_ts_iso = ""

        last = feats.dropna()
        last_row = feats.iloc[-1] if last.empty else last.iloc[-1]
        fv: List[float]=[]
        missing: List[str]=[]
        for name in expected_features:
            if name in last_row.index:
                try: fv.append(float(last_row[name]))
                except Exception: fv.append(0.0)
            else:
                missing.append(name); fv.append(0.0)
        if verbose:
            print(f"[features] {sym} csv={os.path.basename(csv_path)} -> vector len={len(fv)} missing={missing}")
        return (fv, last_ts_iso)
    except Exception as e:
        if verbose:
            print(f"primary: CSV features build failed: {e}")
            traceback.print_exc()
        return None

