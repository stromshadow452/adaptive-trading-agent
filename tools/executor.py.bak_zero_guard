def _infer_side(plan: dict) -> str:
    cand = plan.get("candidate", {}) if isinstance(plan.get("candidate"), dict) else {}
    dec  = plan.get("decision", {})  if isinstance(plan.get("decision"), dict)  else {}
    candidates = [plan.get("side"), dec.get("side"), dec.get("action"), dec.get("signal"),
                  cand.get("side"), cand.get("action"), cand.get("signal")]
    for k in ("is_long","long","go_long"):
        v = dec.get(k, cand.get(k, plan.get(k)))
        if v is True or v==1: return "buy"
    for k in ("is_short","short","go_short"):
        v = dec.get(k, cand.get(k, plan.get(k)))
        if v is True or v==1: return "sell"
    for v in candidates:
        if not isinstance(v,(str,int,float)) or v is None: continue
        s=str(v).strip().lower()
        if s in {"buy","long","b","1","+1"}: return "buy"
        if s in {"sell","short","s","-1"}: return "sell"
    try: score=float(dec.get("final_score", plan.get("final_score", cand.get("score",0))))
    except Exception: score=None
    if isinstance(score,(int,float)) and score is not None:
        if score>0: return "buy"
        if score<0: return "sell"
    return ""

# ==== FinRL inference shim (unwrap first + LightGBM special case) ====
def _finrl_infer_conf(finrl_model: Any, fv: List[float], verbose: bool=False) -> Optional[float]:
    if finrl_model is None or fv is None:
        return None
    finrl_model = _deep_unwrap(finrl_model)
    if verbose:
        print(f"[finrl-debug] effective_model={type(finrl_model).__name__} "
              f"has_proba={hasattr(finrl_model,'predict_proba')} "
              f"has_conf={hasattr(finrl_model,'predict_confidence')} "
              f"has_predict={hasattr(finrl_model,'predict')}")
    try:
        if lgb is not None and isinstance(finrl_model, lgb.Booster):
            booster = finrl_model
            try:
                booster.set_param({"predict_disable_shape_check": True})
            except Exception:
                pass
            nexp = _lgb_expected_nfeat(booster) or 0
            if verbose:
                print(f"[finrl-debug] lgb.Booster expects {nexp} features; live={len(fv)}")
            # Build name->value row using primary feature order
            names = (PRIMARY_META.get("feature_names") or PRIMARY_META.get("features") or TRAIN_FEATURES_DEFAULT)
            live_features_row: Dict[str, float] = {}
            for i, nm in enumerate(names):
                val = fv[i] if i < len(fv) else 0.0
                try:
                    live_features_row[str(nm)] = float(val)
                except Exception:
                    live_features_row[str(nm)] = 0.0
            # Align to booster-trained order (16 cols etc.)
            x = align_features_for_lgb(live_features_row, booster)
            try:
                print(f"[finrl-align] using {x.shape[1]} features in trained order")
            except Exception:
                pass
            try:
                proba = float(booster.predict(x)[0])
                if verbose:
                    print(f"[finrl-debug] lgb.predict -> prob={proba}")
                return proba
            except Exception as e:
                if verbose:
                    print(f"[finrl-debug] lgb.predict error: {e}")
    except Exception:
        pass
    def _try_call(meth: str, payload):
        func = getattr(finrl_model, meth, None)
        if callable(func):
            try:
                return func(payload)
            except Exception:
                return None
        return None
    res = _try_call("predict_proba", [fv])
    if res is not None:
        prob = _to_prob(res[0] if isinstance(res,(list,tuple,np.ndarray)) else res)
        if verbose: print(f"[finrl-debug] predict_proba -> {prob}")
        if prob is not None: return prob
    res = _try_call("predict_confidence", [fv])
    if res is not None:
        val = res[0] if isinstance(res,(list,tuple,np.ndarray)) else res
        prob = _to_prob(val)
        if verbose: print(f"[finrl-debug] predict_confidence -> {prob}")
        if prob is not None: return prob
    res = _try_call("predict", [fv])
    if res is not None:
        val = res[0] if isinstance(res,(list,tuple,np.ndarray)) else res
        prob = _to_prob(val)
        if verbose: print(f"[finrl-debug] predict -> raw:{val} prob:{prob}")
        if prob is not None: return prob
    for m in ("predict_action","act","action"):
        res = _try_call(m, [fv])
        if res is None: res = _try_call(m, fv)
        if res is not None:
            val = res[0] if isinstance(res,(list,tuple,np.ndarray)) else res
            prob = _to_prob(val)
            if verbose: print(f"[finrl-debug] {m} -> raw:{val} prob:{prob}")
            if prob is not None: return prob
    for payload in ([fv], fv):
        res = _try_call("forward", payload)
        if res is not None:
            prob = _to_prob(res)
            if verbose: print(f"[finrl-debug] forward -> {prob}")
            if prob is not None: return prob
        try:
            call_res = finrl_model(payload)
            prob = _to_prob(call_res)
            if verbose: print(f"[finrl-debug] __call__ -> {prob}")
            if prob is not None: return prob
        except Exception:
            pass
    for m in ("decision_function","score"):
        res = _try_call(m, [fv])
        if res is not None:
            prob = _to_prob(res)
            if prob is not None: return prob
    for attr in ("policy_output","last_action","last_logits"):
        try:
            val = getattr(finrl_model, attr, None)
            prob = _to_prob(val)
            if prob is not None:
                return prob
        except Exception:
            pass
    if verbose:
        print(f"[finrl-debug] no usable FinRL method found on {type(finrl_model).__name__}")
    return None

def get_confidences(plan: dict,
                    primary_model: Optional[Any],
                    finrl_model: Optional[Any],
                    primary_features: List[str],
                    csv_price_dirs: List[str],
                    verbose: bool=False) -> Tuple[float, float]:
    sym = _extract_symbol_from_plan(plan, verbose=verbose)
    fv = None
    last_ts_iso = ""
    if primary_model is not None and sym != "UNKNOWN":
        built = build_feature_vector_from_csv(sym, csv_price_dirs, primary_features, verbose=verbose)
        if built is not None:
            fv, last_ts_iso = built

    # persist bar ts on the plan (typed I/O only) if found
    try:
        if last_ts_iso:
            # do not override an existing upstream timestamp
            if not plan.get("_bar_ts_iso"):
                plan["_bar_ts_iso"] = last_ts_iso
    except Exception:
        pass

    primary_conf = heuristic_confidence_from_score(plan)
    if primary_model is not None and fv is not None:
        try:
            if hasattr(primary_model,"predict_proba"):
                prob = primary_model.predict_proba([fv])
                primary_conf = float(max(prob[0])) if len(prob[0]) else primary_conf
            elif hasattr(primary_model,"predict_confidence"):
                primary_conf = float(primary_model.predict_confidence([fv])[0])
            elif hasattr(primary_model,"predict"):
                p = primary_model.predict([fv])
                try:
                    val = float(p[0]); primary_conf = max(0.0,min(1.0,val))
                except Exception: pass
        except Exception:
            if verbose: print("primary model error:", traceback.format_exc())

    finrl_conf = heuristic_confidence_from_score(plan)
    if finrl_model is not None and sym != "UNKNOWN":
        try:
            if fv is None:
                built = build_feature_vector_from_csv(sym, csv_price_dirs, primary_features, verbose=verbose)
                if built is not None:
                    fv, last_ts_iso2 = built
                    # stash timestamp if not already present
                    try:
                        if last_ts_iso2 and not plan.get("_bar_ts_iso"):
                            plan["_bar_ts_iso"] = last_ts_iso2
                    except Exception:
                        pass
            prob = _finrl_infer_conf(finrl_model, fv or [], verbose=verbose)
            if prob is not None:
                finrl_conf = float(prob)
        except Exception:
            if verbose: print("finrl model error:", traceback.format_exc())
        finrl_conf = max(0.0, min(1.0, finrl_conf))

    return max(0.0, min(1.0, primary_conf)), max(0.0, min(1.0, finrl_conf))

def decide_and_execute(plan: dict,
                       primary_model: Optional[Any],
                       finrl_model: Optional[Any],
                       primary_features: List[str],
                       csv_price_dirs: List[str],
                       primary_thresh: Optional[float],
                       finrl_thresh: Optional[float],
                       grey_zone: float,
                       verbose: bool=False) -> Tuple[str, Optional[float], Optional[str]]:
    primary_conf, finrl_conf = get_confidences(
        plan, primary_model, finrl_model, primary_features, csv_price_dirs, verbose=verbose
    )
    sym_local = _extract_symbol_from_plan(plan, verbose=False)

    # ----- Patch: let config take precedence when CLI flags are omitted -----
    p_cli_default = None if primary_thresh is None else float(primary_thresh)
    f_cli_default = None if finrl_thresh  is None else float(finrl_thresh)

    p_thresh = (float(primary_thresh)
                if primary_thresh is not None
                else float(get_threshold_for(sym_local, "primary_thresh", cli_default=None, default=0.58)))
    f_thresh = (float(finrl_thresh)
                if finrl_thresh is not None
                else float(get_threshold_for(sym_local, "finrl_thresh",  cli_default=None, default=0.65)))

    if verbose:
        print(f"[thresh] {sym_local}: resolved p={p_thresh:.3f} (cli={'set' if p_cli_default is not None else 'None'}), "
              f"f={f_thresh:.3f} (cli={'set' if f_cli_default is not None else 'None'})")
        print(f"decide: primary_conf={primary_conf:.3f}, finrl_conf={finrl_conf:.3f}, p_thresh={p_thresh:.3f}, f_thresh={f_thresh:.3f}, grey={grey_zone:.3f}")

    # Primary wins first
    if primary_conf >= p_thresh:
        return "EXECUTE_PRIMARY", 1.0, f"primary_conf={primary_conf:.3f} >= p_thresh={p_thresh:.3f}"

    # Grey-zone gate for FinRL fallback (allow only if primary is close to p_thresh)
    GREY = float(grey_zone)  # e.g., if p_thresh=0.60 and GREY=0.05, allow FinRL if primary >= 0.55
    if finrl_conf >= f_thresh and primary_conf >= (p_thresh - GREY):
        return "EXECUTE_FINRL_FALLBACK", SIZE_REDUCTION_FACTOR, (
            f"finrl_conf={finrl_conf:.3f} >= f_thresh={f_thresh:.3f} "
            f"and primary near gate ({primary_conf:.3f} >= {p_thresh-GREY:.3f})"
        )

    return "SKIPPED_LOW_CONF", None, f"primary_conf={primary_conf:.3f}, finrl_conf={finrl_conf:.3f}"

# ------------------------- Executions CSV I/O -------------------------
EXEC_FIELDS = ["ts","mode","symbol","tf","side","price","size","sl","tp","sl_type","status","order_id","plan_file"]

def read_existing_open_counts(exec_path: str) -> dict:
    counts={}
    if not os.path.exists(exec_path): return counts
    try:
        with open(exec_path,"r",encoding="utf-8",newline="") as f:
            reader=csv.DictReader(f)
            for row in reader:
                if (row.get("status") or "").upper()=="OPEN":
                    sym=(row.get("symbol") or "").upper()
                    counts[sym]=counts.get(sym,0)+1
    except Exception: pass
    return counts

def ensure_exec_header(exec_path: str):
    exists = os.path.exists(exec_path)
    if not exists or os.path.getsize(exec_path)==0:
        os.makedirs(os.path.dirname(exec_path), exist_ok=True)
        with open(exec_path,"w",encoding="utf-8",newline="") as f:
            writer=csv.DictWriter(f, fieldnames=EXEC_FIELDS); writer.writeheader()

def append_execution(exec_path: str, row: dict):
    ensure_exec_header(exec_path)
    with open(exec_path,"a",encoding="utf-8",newline="") as f:
        writer=csv.DictWriter(f, fieldnames=EXEC_FIELDS); writer.writerow(row)

# --- safer cross-platform lockfile context manager (age-based stale cleanup) ---
@contextlib.contextmanager
def _csv_lock(path: str, timeout: float = 5.0, poll: float = 0.02, stale_sec: float = 60.0):
    """
    Acquire a simple lock by creating `path + ".lock"` using O_CREAT|O_EXCL.
    If a lock file exists and is older than `stale_sec`, remove it (stale).
    Wait up to `timeout` seconds before raising TimeoutError.
    """
    lock = path + ".lock"
    start = time.time()
    fd = None
    while True:
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            try:
                os.write(fd, str(os.getpid()).encode("utf-8"))
            except Exception:
                pass
            break
        except FileExistsError:
            try:
                mtime = os.path.getmtime(lock)
                age = time.time() - mtime
                if age > stale_sec:
                    try:
                        os.remove(lock)
                        # retry immediately
                        continue
                    except Exception:
                        pass
            except Exception:
                pass
            if (time.time() - start) > timeout:
                raise TimeoutError(f"Could not acquire CSV lock for {path} (timeout={timeout}s)")
            time.sleep(poll)
        except Exception:
            raise
    try:
        yield
    finally:
        try:
            if fd is not None:
                try: os.close(fd)
                except Exception: pass
            try: os.remove(lock)
            except Exception: pass
        except Exception:
            pass

# ---- NEW: stable plan ordering + idempotent append choke -------------------
def _stable_sort_plans(plans: List[dict]) -> List[dict]:
    def _key(p):
        c = p.get("candidate") or {}
        sym = (p.get("symbol") or c.get("symbol") or "ZZZ").upper()
        tf  = (p.get("tf") or p.get("timeframe") or c.get("tf") or c.get("timeframe") or "UNK").upper()
        return (sym, tf)
    try:
        return sorted(plans, key=_key)
    except Exception:
        return plans

def _exists_in_csv(exec_path: str, row: dict) -> bool:
    """
    Idempotency: treat rows with same (symbol, tf, side) and price within tolerance as duplicates.
    tolerant to string/float formats and minor re-quote differences.
    """
    if not os.path.exists(exec_path) or os.path.getsize(exec_path) == 0:
        return False

    def _norm_key(d: dict):
        return (
            (d.get("symbol","") or "").upper(),
            (d.get("tf","") or "").upper(),
            (d.get("side","") or "").lower(),
        )
    def _to_float(x):
        try: return float(x)
        except Exception:
            try: return float(str(x or "0").strip())
            except Exception: return 0.0

    want_key = _norm_key(row)
    want_px = _to_float(row.get("price"))
    TOL = 1e-5  # acceptable price tolerance

    try:
        with open(exec_path, "r", encoding="utf-8", newline="") as f:
            rdr = csv.DictReader(f)
            for r in rdr:
                if (r.get("status","").upper() != "OPEN"):
                    continue
                if _norm_key(r) != want_key:
                    continue
                existing_px = _to_float(r.get("price"))
                if abs(existing_px - want_px) <= TOL:
                    return True
    except Exception:
        return False
    return False

def append_execution_safe(exec_path: str, row: dict, *, dry_run: bool):
    # Single choke point for all writes
    if dry_run:
        return  # never touch disk in dry-run

    # 1) Normalize time: prefer upstream 'timestamp' or 'ts', else fallback to now_utc_iso()
    ts = row.get("timestamp") or row.get("ts") or now_utc_iso()
    row["timestamp"] = ts
    row["ts"] = row.get("ts") or ts

    # 2) Normalize price precision (helps duplicate detection)
    try:
        row["price"] = f"{float(row['price']):.8f}"
    except Exception:
        pass

    # 3) Ensure header exists and atomically avoid duplicates with lock
    ensure_exec_header(exec_path)
    try:
        with _csv_lock(exec_path, timeout=5.0, stale_sec=60.0):
            if _exists_in_csv(exec_path, row):
                return
            # 4) Deterministic, schema-only write
            clean = {k: row.get(k, "") for k in EXEC_FIELDS}
            append_execution(exec_path, clean)
    except TimeoutError:
        # fallback write if lock not acquired
        if _exists_in_csv(exec_path, row):
            return
        clean = {k: row.get(k, "") for k in EXEC_FIELDS}
        append_execution(exec_path, clean)

def _normalize_agg_rows(rows: list[dict]) -> list[dict]:
    """Drop volatile fields and sort deterministically."""
    keep = ("symbol","tf","side","price","size","sl","tp","sl_type","status","plan_file")
    out: list[dict] = []
    for r in (rows or []):
        try:
            clean = {k: r.get(k) for k in keep}
            if "decision_reason" in r:
                clean["decision_reason"] = r["decision_reason"]
            out.append(clean)
        except Exception:
            continue
    out.sort(key=lambda x: (str(x.get("symbol","")), str(x.get("tf","")), str(x.get("side",""))))
    return out

def write_aggregate_safe(path: str, payload: dict, *, dry_run: bool):
    """Deterministic aggregate in dry_run; normal write otherwise."""
    if not path or not payload:
        return
    obj = payload
    if dry_run:
        if isinstance(payload, dict) and isinstance(payload.get("orders"), list):
            obj = {"opened": int(payload.get("opened", 0)),
                   "orders": _normalize_agg_rows(payload["orders"])}
        elif isinstance(payload, list):
            obj = _normalize_agg_rows(payload)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, sort_keys=True, ensure_ascii=True, separators=(",", ":"))

def main():
    global _STRICT_META, _EXPECT_TF
    ap = argparse.ArgumentParser(description="Executor v6.7")
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--approved", help="approved.json (portfolio gate output)")
    src.add_argument("--plans", help="folder containing *_plan_*.json")

    ap.add_argument("--executions", required=True, help="executions CSV path to append")
    ap.add_argument("--aggregate", default=None, help="aggregate summary JSON (optional)")
    ap.add_argument("--max_position", type=int, default=1, help="max OPEN positions per symbol")
    ap.add_argument("--universe", default=None, help="forex | crypto | fx+crypto (optional filter)")

    ap.add_argument("--csv_price_dir", action="append", default=[], help="CSV price root (repeatable)")
    ap.add_argument("--require_csv_price", action="store_true", help="skip order if no CSV price found")
    ap.add_argument("--mode", choices=["paper","live"], default="paper")

    ap.add_argument("--exclude", action="append", default=[], help="Symbol to skip (repeatable)")
    ap.add_argument("--primary_thresh", type=float, default=None, help="primary confidence threshold (0..1)")
    ap.add_argument("--finrl_thresh", type=float, default=None, help="finrl confidence threshold (0..1)")

    ap.add_argument("--model_primary_path", default="models/primary.joblib", help="path to primary model payload/joblib")
    ap.add_argument("--model_finrl_path", default=None, help="path to finrl model joblib OR directory for auto-pick")
    ap.add_argument("--dry_run", action="store_true", help="do not write to executions CSV; only print")
    ap.add_argument("--verbose", action="store_true", help="verbose logging")

    # Guards
    ap.add_argument("--strict_meta", action="store_true", help="Fail if model metadata and live features don't match.")
    ap.add_argument("--expect_timeframe", default="", help="Require timeframe in model metadata (e.g., M15).")

    # Broker clamp
    ap.add_argument("--broker_min_lot", type=float, default=0.01, help="Broker minimum lot size")
    ap.add_argument("--broker_lot_step", type=float, default=0.01, help="Broker lot step/increment")
    ap.add_argument("--decision_min_size", type=float, default=0.01, help="Decision minimum size floor")

    # Extra switches
    ap.add_argument("--disable_finrl", action="store_true", help="Skip all FinRL checks and fallbacks")
    ap.add_argument("--grey_zone", type=float, default=0.05, help="Primary score band for FinRL fallback (default 0.05)")
    ap.add_argument("--allow_symbols", nargs="*", default=[], help="If provided, restrict trading strictly to these symbols")

    args = ap.parse_args()
    _STRICT_META = bool(args.strict_meta)
    _EXPECT_TF = str(args.expect_timeframe or "").strip()

    exclude_set = {normalize_symbol(s).upper() for s in (args.exclude or []) if s}
    allow_set   = {normalize_symbol(s).upper() for s in (args.allow_symbols or []) if s}

    primary_model, primary_features = _load_model_and_features(args.model_primary_path, verbose=args.verbose)
    if args.verbose and primary_model is None:
        print("No primary model loaded — heuristic fallback will be used.")
    finrl_model, _ = _load_model_and_features(args.model_finrl_path, verbose=args.verbose) if args.model_finrl_path else (None, TRAIN_FEATURES_DEFAULT)
    if finrl_model is None and args.verbose:
        print("No finrl model preloaded — will use per-symbol auto-pick if a folder was provided, else heuristic fallback.")
    # If a single model path (not a directory) was provided, wrap it now (unless disabled)
    if (not args.disable_finrl) and finrl_model is not None and not os.path.isdir(str(args.model_finrl_path or "")):
        finrl_model = _wrap_generic(finrl_model)

    # Sidecar-driven info (consistent banner)
    meta_info = {}
    try: meta_info = load_sidecar_meta(args.model_primary_path)
    except Exception: meta_info = {}
    try:
        expected = meta_info.get("feature_names") or primary_features
        exp_hash = feature_list_hash(expected)
    except Exception:
        expected = primary_features
        exp_hash = feature_list_hash(expected)

    print("=== Model Info ===")
    print(f"  name: {os.path.splitext(os.path.basename(args.model_primary_path))[0]}")
    print(f"  version: {meta_info.get('version','n/a')}")
    print(f"  timeframe: {meta_info.get('timeframe','n/a')}")
    print(f"  features: {len(expected)}  order_hash={exp_hash}")

    primary_features = list(expected)

    if _EXPECT_TF:
        tfm = PRIMARY_META.get("timeframe") or PRIMARY_META.get("tf") or PRIMARY_META.get("tf_filter")
        if not tfm or _EXPECT_TF.lower() not in str(tfm).lower():
            msg = f"model timeframe '{tfm}' does not satisfy --expect_timeframe '{_EXPECT_TF}'"
            if _STRICT_META: raise SystemExit(f"[meta] ERROR: {msg}")
            else: print(f"[meta] warn: {msg}")

    if args.verbose:
        dummy = {"decision":{"final_score":-1.0}, "candidate":{"atr":0.01}, "_plan_path":"EURUSD_M15_plan_x.json"}
        try:
            pc, fc = get_confidences(dummy, primary_model, None if args.disable_finrl else finrl_model, primary_features, args.csv_price_dir, verbose=args.verbose)
            print(f"[model sanity] primary_conf={pc:.3f}, finrl_conf={fc:.3f}")
        except Exception:
            print("[model sanity] error computing confidences:", traceback.format_exc())

    # Load plans
    plans: List[dict]=[]
    def _load_one(path: str, tag: str):
        try:
            with open(path,"r",encoding="utf-8-sig") as f:
                data=json.load(f)
            if isinstance(data,list):
                for d in data:
                    if isinstance(d,dict):
                        d["_plan_path"]=path; plans.append(d)
            elif isinstance(data,dict):
                data["_plan_path"]=path; plans.append(data)
        except Exception:
            pass

    if args.approved:
        try:
            with open(args.approved,"r",encoding="utf-8-sig") as f:
                obj=json.load(f)
            if isinstance(obj,dict) and "approved" in obj: obj=obj["approved"]
            if isinstance(obj,list) and obj and all(isinstance(x,str) for x in obj):
                for p in obj:
                    if os.path.isdir(p):
                        for path in sorted(glob.glob(os.path.join(p,"*_plan_*.json"))):
                            _load_one(path,"dir")
                    elif os.path.isfile(p):
                        _load_one(p,"file")
            elif isinstance(obj,list) and obj and isinstance(obj[0],dict):
                for d in obj:
                    if isinstance(d,dict):
                        d["_plan_path"]=args.approved; plans.append(d)
            elif isinstance(obj,dict):
                obj["_plan_path"]=args.approved; plans.append(obj)
            else:
                _load_one(args.approved,"fallback")
        except Exception as e:
            print(f"Failed to load approved: {e}"); plans=[]
    else:
        folder = args.plans or ""
        for p in sorted(glob.glob(os.path.join(folder,"*_plan_*.json"))):
            _load_one(p,"plans")

    plans = _stable_sort_plans(plans)

    if not plans:
        print(f"Executed (opened): 0 (dry_run={args.dry_run})")
        return 0

    if not args.dry_run: ensure_exec_header(args.executions)
    open_counts = read_existing_open_counts(args.executions) if (not args.dry_run) else {}

    # --- ADD: collect rows deterministically for artifacts (dry_run and aggregate) ---
    rows_out: List[dict] = []

    # --- NEW: stable plan order for determinism ---
    plans = _stable_sort_plans(plans)

    opened=0
    rcfg_for_patch={}
    simple_price_dir = args.csv_price_dir[0] if args.csv_price_dir else None
    agg_rows: list[dict] = []

    for plan in plans:
        if not isinstance(plan,dict): continue
        cand = plan.get("candidate", {}) if isinstance(plan.get("candidate"), dict) else {}
        sym  = _extract_symbol_from_plan(plan, verbose=args.verbose)
        if not plan.get("symbol"): plan["symbol"]=sym
        tf   = plan.get("tf") or plan.get("timeframe") or cand.get("tf") or cand.get("timeframe") or "UNK"
        side = _infer_side(plan); plan["side"]=side

        if sym in exclude_set:
            if args.verbose: print(f"SKIP {sym}: excluded."); continue
        if args.allow_symbols and sym not in allow_set:
            if args.verbose: print(f"SKIP {sym}: not in allowlist {sorted(allow_set)}."); continue
        if not in_universe(sym, args.universe):
            if args.verbose: print(f"SKIP {sym}: not in universe {args.universe}."); continue

        cur_open = open_counts.get(sym,0)
        max_pos  = int(get_threshold_for(sym, "max_position", cli_default=args.max_position))
        if cur_open >= max(1, max_pos):
            if args.verbose: print(f"SKIP {sym}: at cap ({cur_open} >= {max_pos})."); continue

        price = _safe_float(plan.get("price"),0.0)
        used_path=None
        if price<=0.0 and args.csv_price_dir:
            px, pth = resolve_price_from_dirs(sym, args.csv_price_dir, verbose=args.verbose)
            if px is not None and px>0: plan["price"]=px; price=px; used_path=pth
        csv_hint = cand.get("csv_path")
        if price<=0.0 and csv_hint and os.path.isfile(csv_hint):
            px=_read_last_close_any(csv_hint)
            if px is not None and px>0: plan["price"]=px; price=px; used_path=csv_hint
        if price<=0.0 and simple_price_dir:
            plan = ensure_price_and_size(plan, rcfg_for_patch, simple_price_dir)
            price = _safe_float(plan.get("price"),0.0)
        if price<=0.0 and args.csv_price_dir:
            px = _super_last_price_guess(sym, args.csv_price_dir)
            if px is not None and px>0:
                plan["price"]=px; price=px
                if args.verbose: print(f"[price-last] {sym}: FOUND value={px}")

        # ------------------ STALE-BAR GUARD (NEW) ------------------
        # Prefer an upstream zero-I/O bar timestamp; if not present, try resolve via used_path.
        last_ts = plan.get("_bar_ts_iso") or (_resolve_last_ts(sym, used_path) if used_path else "")
        if last_ts:
            # if the last bar is stale, skip the plan (protects both dry-run and live)
            if _stale_csv_guard(last_ts, max_age_min=15):
                if args.verbose: print(f"SKIP {sym}: stale bar ({last_ts})")
                continue
            # stash for downstream usage (do not overwrite existing plan _bar_ts_iso)
            plan["_bar_ts_iso"] = plan.get("_bar_ts_iso") or last_ts
        # ---------------- END STALE-BAR GUARD --------------------

        if args.require_csv_price and (price is None or price==0):
            if args.verbose: print(f"SKIP {sym}: require_csv_price True but no CSV price found.")
            continue

        price = float(price or 0.0)

        size_plan = float(plan.get("size") or plan.get("decision", {}).get("size") or 0.0)
        sl, tp = plan.get("sl"), plan.get("tp")
        sltype = plan.get("sl_type") or plan.get("decision", {}).get("sl_type") or "none"

        if side in {"buy","sell"} and size_plan<=0 and price>0.0:
            atr_hint = plan.get("atr")
            if atr_hint is None:
                cand_atr = cand.get("atr") or cand.get("atr14")
                atr_hint = cand_atr if isinstance(cand_atr,(int,float,str)) else None
            try: atr_val=float(atr_hint) if atr_hint is not None else 0.0
            except Exception: atr_val=0.0
            size_plan=_fallback_size_from_price_atr(price=price, atr=atr_val,
                                                    risk_per_trade=0.01, equity=10000.0,
                                                    stop_atr_mult=1.5, sl_pct=0.01,
                                                    min_size=0.001, max_size=0.05)

        if size_plan>0:
            size_plan = _lot_clamp(size_plan, min_lot=args.broker_min_lot, lot_step=args.broker_lot_step, min_size_cfg=args.decision_min_size)

        if side not in {"buy","sell"} or size_plan<=0:
            if args.verbose: print(f"SKIP {sym}: invalid side/size (side={side}, size={size_plan}).")
            continue

        finrl_model_eff = None if args.disable_finrl else finrl_model
        if (not args.disable_finrl) and args.model_finrl_path and os.path.isdir(args.model_finrl_path):
            picked = _try_finrl_for_symbol(sym, str(tf).upper(), args.model_finrl_path)
            if picked is None: picked = _try_finrl_for_symbol(sym, str(tf).lower(), args.model_finrl_path)
            if picked is not None:
                finrl_model_eff = picked
                if args.verbose: print(f"[finrl] {sym} {tf}: using per-symbol FinRL model from '{args.model_finrl_path}'")

        decision, size_factor, reason = decide_and_execute(
            plan, primary_model, finrl_model_eff, primary_features, args.csv_price_dir,
            args.primary_thresh, args.finrl_thresh, args.grey_zone, verbose=args.verbose
        )
        if decision.startswith("SKIPPED"):
            if args.verbose: print(f"SKIP {sym}: {reason}")
            continue

        final_size = _lot_clamp(size_plan*(size_factor or 1.0),
                                min_lot=args.broker_min_lot, lot_step=args.broker_lot_step, min_size_cfg=args.decision_min_size)

        order_id = f"{sym}-{int(time.time()*1000)}"
        row = {
            "ts": "", "mode": args.mode, "symbol": sym, "tf": tf, "side": side,
            "price": f"{price:.8f}", "size": f"{final_size:.8f}",
            "sl": "" if sl is None else f"{float(sl):.8f}",
            "tp": "" if tp is None else f"{float(tp):.8f}",
            "sl_type": sltype, "status": "OPEN", "order_id": order_id,
            "plan_file": plan.get("_plan_path") or (args.approved or args.plans),
        }

        # prefer plan-stashed bar ts if present (zero-I/O)
        if plan.get("_bar_ts_iso"):
            row["timestamp"] = plan.get("_bar_ts_iso")

        agg_rows.append(row.copy())
        # --- keep a copy for artifact writers (dry-run safe) ---
        rows_out.append(row.copy())

        # idempotency: short-circuit early (avoid extra file I/O)
        if _exists_in_csv(args.executions, row):
            if args.verbose: print(f"[idempotent-skip] {sym} {tf} {side} @ {row.get('price')}")
            continue

        if args.dry_run:
            decision_ts = row.get("timestamp") or row.get("ts") or (plan.get("_bar_ts_iso") or "")
            ts_src = ("decision_ctx.bar_ts_iso" if plan.get("_bar_ts_iso")
                      else "row.ts" if row.get("ts")
                      else "missing")
            if args.verbose: print(f"[ts] src={ts_src} ts={decision_ts}")
            if (os.environ.get("STRICT_NO_CSV_TS","0") == "1") and (ts_src == "missing"):
                raise SystemExit("[FAIL:Execution Reflex Engine] timestamp fell back to csv_resolver with STRICT_NO_CSV_TS=1")
            print(f"[DRY OPEN] {sym} {tf} {side} price={price:.6f} size={final_size:.6f}  -> {decision}: {reason}")
            exec_row = {
                "timestamp": (decision_ts or ""),
                "symbol":       sym,
                "side":         side,
                "size":         final_size,
                "price":        row.get("price"),
                "primary_conf": locals().get("primary_conf"),
                "finrl_conf":   locals().get("finrl_conf"),
                "source":       "execution_reflex",
            }
            _require_exec_timestamp(exec_row)
            opened += 1
            open_counts[sym] = open_counts.get(sym,0)+1
            continue

        # ---- single choke for writes (idempotent + locked) ----
        append_execution_safe(args.executions, row, dry_run=args.dry_run)
        opened += 1
        open_counts[sym] = open_counts.get(sym,0)+1
        if used_path:
            print(f"[OPEN] {sym} {tf} {side} price={price:.6f} size={final_size:.6f} (csv={used_path})  -> {decision}: {reason}")
        else:
            print(f"[OPEN] {sym} {tf} {side} price={price:.6f} size={final_size:.6f}  -> {decision}: {reason}")

    # NOTE: Idempotency guard — do NOT write executions in dry_run unless explicitly allowed
    if args.dry_run and DRY_WRITE_ALLOWED and args.executions and rows_out:
        try:
            ensure_exec_header(args.executions)
            for r in rows_out:
                # ensure both legacy 'ts' and guard 'timestamp' are present before append
                r["timestamp"] = (r.get("timestamp") or r.get("ts") or now_utc_iso())
                if not r["timestamp"]:
                    raise SystemExit("[FAIL:Execution Reflex Engine] missing timestamp (pre-write batch)")
                r["ts"] = r.get("ts") or r["timestamp"]
                # normalize price string
                try: r["price"] = f"{float(r['price']):.8f}"
                except Exception: pass
                # strict schema
                clean = {k: r.get(k, "") for k in EXEC_FIELDS}
                append_execution_safe(args.executions, clean, dry_run=args.dry_run)
            if args.verbose:
                print(f"[artifact] wrote executions -> {args.executions} (dry_run)")
        except Exception as e:
            print(f"[warn] could not write executions file: {e}")
    if args.aggregate:
        write_aggregate_safe(args.aggregate, {"opened": opened, "orders": agg_rows}, dry_run=args.dry_run)
        print(f"[artifact] wrote aggregate -> {args.aggregate}")
    print(f"Executed (opened): {opened} (dry_run={args.dry_run})")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
