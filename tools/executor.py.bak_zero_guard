def now_utc_iso() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")

SEP_RE       = re.compile(r"[^A-Za-z]")
QUOTE_MAP    = {"USDT":"USD","BUSD":"USD","USDC":"USD"}
FX_CCY       = {"USD","EUR","JPY","GBP","AUD","NZD","CAD","CHF"}
CRYPTO_BASES = {"BTC","ETH","SOL","XRP","BNB","ADA","DOGE","DOT","LTC","XMR","AVAX","SHIB","TRX","LINK","UNI","MATIC"}
METALS       = {"XAU","XAG"}
QUOTE_PREFS  = ["USDT","USDC","BUSD","USD"]

def normalize_symbol(sym: str) -> str:
    if not sym: return ""
    s = SEP_RE.sub("", str(sym).upper())
    if len(s)<6: return s
    base = s[:3]; quote_raw = s[3:]; quote = QUOTE_MAP.get(quote_raw, quote_raw[:3])
    return f"{base}{quote}"

def classify_symbol(sym: str) -> str:
    s = normalize_symbol(sym)
    if len(s)<6: return "other"
    base, quote = s[:3], s[3:6]
    if base in CRYPTO_BASES: return "crypto"
    if (base in FX_CCY or base in METALS) and (quote in FX_CCY): return "forex"
    return "other"

def in_universe(sym: str, universe: Optional[str]) -> bool:
    if not universe: return True
    u = universe.replace(" ", "").lower()
    kind = classify_symbol(sym)
    if u in {"fx+crypto","forex,crypto","crypto,forex"}: return kind in {"forex","crypto"}
    if u == "forex": return kind=="forex"
    if u == "crypto": return kind=="crypto"
    return True

