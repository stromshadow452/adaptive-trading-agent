<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SCOPUS Pro Dashboard</title>
    <link rel="stylesheet" href="styles.css">
    <script src="https://unpkg.com/lightweight-charts@3.8.0/dist/lightweight-charts.standalone.production.js"></script>
</head>

<body>
    <nav class="navbar">
        <a href="index.html" class="navbar-brand">📊 SCOPUS</a>
        <div class="navbar-links">
            <a href="index.html" class="navbar-link active">Dashboard</a>
            <a href="history.html" class="navbar-link">History</a>
            <div class="status" id="connectionStatus">
                <div class="status-dot"></div>
                <span>Connecting...</span>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="header">
            <h1>SCOPUS Pro Dashboard</h1>
        </div>

        <!-- 3-Column Layout -->
        <div class="main-grid">
            <!-- Column 1: Configuration -->
            <div class="card">
                <h2 class="card-title">Configuration</h2>

                <div class="form-group">
                    <label class="form-label">Symbol</label>
                    <select id="symbol" class="form-select">
                        <option value="EURUSD">EURUSD</option>
                        <option value="GBPUSD">GBPUSD</option>
                        <option value="USDJPY">USDJPY</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Date Range</label>
                    <div class="date-group">
                        <input type="date" id="startDate" class="form-input" value="2023-01-01">
                        <input type="date" id="endDate" class="form-input" value="2023-01-07">
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Initial Capital ($)</label>
                    <input type="number" id="capital" class="form-input" value="10000">
                </div>

                <button id="runBtn" class="btn">RUN BACKTEST</button>
                <button id="trainBtn" class="btn btn-secondary" style="display:none;">TRAIN AGENT</button>

                <div id="progressContainer" class="progress-container" style="display:none;">
                    <div class="progress-bar">
                        <div id="progressFill" class="progress-fill"></div>
                    </div>
                    <div id="progressText" class="progress-text"></div>
                </div>
            </div>

            <!-- Column 2: Execution Console -->
            <div class="card">
                <h2 class="card-title">Execution Console</h2>
                <div id="console" class="console"></div>
            </div>

            <!-- Column 3: Performance Metrics -->
            <div class="card">
                <h2 class="card-title">Performance Metrics</h2>
                <div class="metrics-grid">
                    <div class="metric-tile">
                        <div class="metric-label">TOTAL TRADES</div>
                        <div id="metricTrades" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">WIN RATE</div>
                        <div id="metricWinrate" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">TOTAL P&L</div>
                        <div id="metricPnl" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">SHARPE RATIO</div>
                        <div id="metricSharpe" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">MAX DRAWDOWN</div>
                        <div id="metricMaxDD" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">PROFIT FACTOR</div>
                        <div id="metricProfitFactor" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">EXEC TIME</div>
                        <div id="metricExecTime" class="metric-value">—</div>
                    </div>
                    <div class="metric-tile">
                        <div class="metric-label">SOURCE</div>
                        <div id="metricSource" class="metric-value neutral">—</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart Section -->
        <div class="chart-section">
            <h2 class="card-title">Price Chart & Trade Markers</h2>
            <div id="chart-container" style="position: relative;">
                <div id="chart-loading" class="loading-overlay" style="display:none;">Loading Chart...</div>
            </div>
            <h2 class="card-title" style="margin-top: 1.5rem;">Equity Curve</h2>
            <div id="equity-chart"></div>
        </div>
    </div>

    <script>
        const API_BASE = "http://127.0.0.1:8000";

        // Global State
        let currentJobId = null;
        let progressTimer = null;
        let lastStep = null;
        let lastPct = 0;
        let lastStatus = null;
        let finalProgressSnapshot = null;
        let lastUpdateTime = Date.now();

        // Console
        const MAX_LOG_LINES = 300;
        let consoleLines = [];

        // Charts
        let priceChartObj, priceSeriesObj, equityChartObj, equitySeriesObj;
        let currentRunId = null;

        // Helpers
        function $(id) { return document.getElementById(id); }

        // Console Functions
        function appendConsoleLine(text) {
            const timestamp = new Date().toLocaleTimeString('en-US', { hour12: false });
            consoleLines.push(`[${timestamp}] ${text}`);

            if (consoleLines.length > MAX_LOG_LINES) {
                consoleLines.shift();
            }

            renderConsole();
            scrollConsoleToBottom();
        }

        function logInfo(msg) { appendConsoleLine(msg); }
        function logSuccess(msg) { appendConsoleLine(`✅ ${msg}`); }
        function logError(msg) { appendConsoleLine(`❌ ${msg}`); }

        function renderConsole() {
            const consoleEl = $('console');
            consoleEl.innerHTML = consoleLines.map(line =>
                `<div class="console-line">${line}</div>`
            ).join('');
        }

        function scrollConsoleToBottom() {
            const consoleEl = $('console');
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        // Charts
        function initCharts() {
            console.log("[DASHBOARD] Initializing charts...");
            const pc = $("chart-container"), ec = $("equity-chart");
            if (!pc || !ec) return console.error("Containers not found");

            const opts = {
                layout: { background: { color: "#fff" }, textColor: "#1f2937" },
                grid: { vertLines: { color: "#e5e7eb" }, horzLines: { color: "#e5e7eb" } },
                width: pc.clientWidth,
                height: 400,
                crosshair: { mode: 1 },
                rightPriceScale: { borderVisible: false },
                timeScale: { borderVisible: false }
            };

            priceChartObj = LightweightCharts.createChart(pc, opts);
            priceSeriesObj = priceChartObj.addCandlestickSeries({
                upColor: "#22c55e",
                downColor: "#ef4444",
                wickUpColor: "#22c55e",
                wickDownColor: "#ef4444",
                borderVisible: false
            });

            equityChartObj = LightweightCharts.createChart(ec, { ...opts, height: 200 });
            equitySeriesObj = equityChartObj.addAreaSeries({
                lineColor: "#7c3aed",
                topColor: "rgba(124,58,237,0.4)",
                bottomColor: "rgba(124,58,237,0.05)"
            });

            console.log("[DASHBOARD] Charts ready!");
        }

        // Connection Status
        async function updateConnectionStatus() {
            const s = $("connectionStatus"), d = s.querySelector(".status-dot"), t = s.querySelector("span");
            try {
                const r = await fetch(`${API_BASE}/`);
                if (r.ok) { t.textContent = "Connected"; d.style.background = "#10b981"; }
                else { t.textContent = `Error ${r.status}`; d.style.background = "#ef4444"; }
            } catch { t.textContent = "Disconnected"; d.style.background = "#ef4444"; }
        }

        // API Helpers
        async function apiGet(p) {
            const r = await fetch(`${API_BASE}${p}`);
            if (!r.ok) throw new Error(`GET ${p} -> ${r.status}`);
            return r.json();
        }

        async function apiPost(p, b) {
            const r = await fetch(`${API_BASE}${p}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(b)
            });
            if (!r.ok) throw new Error(`POST ${p} -> ${r.status}`);
            return r.json();
        }

        // Progress Polling
        function startProgressPolling(jobId) {
            currentJobId = jobId;
            lastUpdateTime = Date.now();

            if (progressTimer) clearInterval(progressTimer);

            progressTimer = setInterval(async () => {
                try {
                    const progress = await apiGet(`/progress/${jobId}.json`);
                    handleProgressUpdate(progress);
                } catch (e) {
                    // If 404, job not started yet
                    lastStep = progress.current_step;
                }

                // Check for error status
                if (progress.status === 'error') {
                    stopProgressPolling();
                    logError(`Backtest failed: ${progress.current_step}`);
                    $('progressFill').classList.add('error');
                    $('runBtn').disabled = false;
                    return;
                }

                // Check completion
                if (progress.status === 'completed' && progress.progress_pct === 100) {
                    stopProgressPolling();
                    onBacktestCompleted(currentJobId);
                }
            }

        // Backtest Flow
        async function runBacktest() {
                    const sym = $("symbol").value;
                    const start = $("startDate").value;
                    const end = $("endDate").value;
                    const cap = parseFloat($("capital").value || "10000");

                    // Reset state
                    consoleLines = [];
                    renderConsole();
                    lastStep = null;
                    lastPct = 0;
                    lastStatus = null;

                    // UI updates
                    $("runBtn").disabled = true;
                    $("trainBtn").style.display = "none";
                    $("progressContainer").style.display = "";
                    $("progressFill").style.width = "0%";
                    $("progressFill").classList.remove('error');
                    $("progressText").textContent = "Submitting...";
                    $("chart-loading").style.display = "";

                    logInfo('Submitting backtest job...');

                    try {
                        const data = await apiPost("/jobs/submit/backtest", {
                            config: "config/mvp_v1.yaml",
                            symbols: [sym],
                            start,
                            end,
                            initial_capital: cap
                        });

                        currentJobId = data.job_id;
                        logSuccess(`Job submitted: ${currentJobId}`);
                        logInfo('Loading price data...');

                        // Load OHLCV
                        const ohlcv = await apiGet(`/api/ohlcv?symbol=${sym}&start=${start}&end=${end}`);

                        if (Array.isArray(ohlcv) && ohlcv.length > 0) {
                            priceSeriesObj.setData(ohlcv);
                            priceChartObj.timeScale().fitContent();
                            logSuccess(`Price data loaded: ${ohlcv.length} candles`);
                        } else {
                            logError('No price data available');
                        }

                        logInfo('Waiting for backtest to start...');

                        // Start polling
                        startProgressPolling(currentJobId);

                    } catch (e) {
                        console.error("Backtest failed:", e);
                        logError(`Failed to submit job: ${e.message}`);
                        $("runBtn").disabled = false;
                        $("chart-loading").style.display = "none";
                    }
                }

        // Completion Handler
        async function onBacktestCompleted(job_id) {
                    stopProgressPolling();

                    const execTime = finalProgressSnapshot?.elapsed_sec ?? null;

                    logSuccess('Backtest execution completed!');
                    logInfo('Fetching results...');

                    try {
                        const run = await apiGet(`/backtests/run/${job_id}`);
                        const trades = await apiGet(`/backtests/run/${job_id}/trades`);

                        const perf = run.performance || run.metrics || {};
                        const tradesCount = perf.trades || perf.total_trades || 0;

                        if (!tradesCount) {
                            logInfo('No trades generated for this config.');
                        }

                        // Render metrics
                        renderMetrics(run, execTime);

                        // Render charts
                        if (tradesCount > 0) {
                            await renderCandlesAndTrades(run, trades);
                        }

                        // Log summary
                        logInfo(`Total trades: ${tradesCount}`);
                        logInfo(`Win rate: ${((perf.winrate || 0) * 100).toFixed(1)}%`);
                        logInfo(`Total P&L: $${(perf.pnl || 0).toFixed(2)}`);
                        logInfo(`Max DD: ${((perf.max_drawdown || 0) * 100).toFixed(2)}%`);
                        logInfo(`Sharpe: ${(perf.sharpe || 0).toFixed(2)}`);

                        // Store for history
                        localStorage.setItem('lastCompletedRunId', job_id);
                        currentRunId = job_id;

                        // Enable buttons
                        $('runBtn').disabled = false;
                        $('trainBtn').style.display = '';
                        $('chart-loading').style.display = 'none';
                        $('progressText').textContent = 'Completed!';

                    } catch (e) {
                        logError(`Failed to fetch results: ${e.message}`);
                        $('runBtn').disabled = false;
                    }
                }

        // Render Metrics
        function renderMetrics(run, execTime) {
                    const perf = run.performance || run.metrics || {};

                    $('metricTrades').textContent = perf.trades || perf.total_trades || 0;

                    const winrate = (perf.winrate || 0) * 100;
                    $('metricWinrate').textContent = `${winrate.toFixed(1)}%`;

                    const pnl = perf.pnl || 0;
                    $('metricPnl').textContent = `$${pnl.toFixed(2)}`;
                    $('metricPnl').className = `metric-value ${pnl >= 0 ? 'positive' : 'negative'}`;

                    $('metricSharpe').textContent = (perf.sharpe || 0).toFixed(2);

                    const maxDD = (perf.max_drawdown || 0) * 100;
                    $('metricMaxDD').textContent = `${maxDD.toFixed(2)}%`;
                    $('metricMaxDD').className = 'metric-value negative';

                    $('metricProfitFactor').textContent = (perf.profit_factor || 0).toFixed(2);

                    if (execTime) {
                        $('metricExecTime').textContent = `${Math.round(execTime)}s`;
                    }

                    // Determine source
                    const flags = run.config_flags || {};
                    let source = 'PRIMARY';
                    if (flags.use_meta_judge && flags.use_finrl) source = 'META+RL';
                    else if (flags.use_meta_judge) source = 'META';
                    else if (flags.use_finrl) source = 'RL';
                    $('metricSource').textContent = source;
                }

        // Render Charts
        async function renderCandlesAndTrades(run, trades) {
                    try {
                        logInfo('Rendering trade markers...');

                        const markers = [];
                        for (const t of trades) {
                            const entryTime = Math.floor(new Date(t.timestamp_entry).getTime() / 1000);
                            const exitTime = Math.floor(new Date(t.timestamp_exit).getTime() / 1000);
                            const isBuy = t.side.toLowerCase() === 'buy';

                            // Entry marker
                            markers.push({
                                time: entryTime,
                                position: isBuy ? 'belowBar' : 'aboveBar',
                                color: isBuy ? '#3b82f6' : '#f97316',
                                shape: isBuy ? 'arrowUp' : 'arrowDown',
                                text: t.side.toUpperCase()
                            });

                            // Exit marker
                            markers.push({
                                time: exitTime,
                                position: isBuy ? 'aboveBar' : 'belowBar',
                                color: t.pnl >= 0 ? '#10b981' : '#ef4444',
                                shape: 'circle',
                                text: `$${t.pnl.toFixed(0)}`
                            });
                        }

                        priceSeriesObj.setMarkers(markers);
                        logSuccess('Trade markers added');

                        // Equity curve
                        logInfo('Building equity curve...');
                        const equityData = buildEquityCurve(trades, run.initial_capital || 10000);
                        equitySeriesObj.setData(equityData);
                        equityChartObj.timeScale().fitContent();
                        logSuccess('Equity curve rendered');

                    } catch (e) {
                        logError(`Chart rendering failed: ${e.message}`);
                    }
                }

        function buildEquityCurve(trades, initialCapital) {
                    let eq = initialCapital;
                    const pts = [];
                    const sorted = [...trades].sort(
                        (a, b) => new Date(a.timestamp_exit) - new Date(b.timestamp_exit)
                    );
                    for (const t of sorted) {
                        eq += t.pnl;
                        pts.push({
                            time: Math.floor(new Date(t.timestamp_exit).getTime() / 1000),
                            value: eq
                        });
                    }
                    return pts;
                }

        // Training
        async function runTraining() {
                    if (!currentRunId) return;
                    const btn = $("trainBtn");
                    btn.disabled = true;
                    btn.textContent = "Training...";

                    try {
                        const data = await apiPost("/jobs/submit/training", {
                            run_id: currentRunId,
                            symbol: $("symbol").value
                        });
                        logSuccess(`Training started: ${data.job_id}`);
                        btn.textContent = "✅ Started";
                        btn.disabled = false;
                    } catch (e) {
                        logError(`Training failed: ${e.message}`);
                        btn.disabled = false;
                        btn.textContent = "TRAIN AGENT";
                    }
                }

        // Initialize
        document.addEventListener("DOMContentLoaded", () => {
                    console.log("[DASHBOARD] Starting SCOPUS Pro...");
                    logInfo('SCOPUS Pro Dashboard initialized');
                    logInfo('Waiting for user input...');

                    initCharts();
                    updateConnectionStatus();
                    setInterval(updateConnectionStatus, 5000);

                    $("runBtn").addEventListener("click", runBacktest);
                    $("trainBtn").addEventListener("click", runTraining);
                });
    </script>
</body>

</html>